// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                      String   @id @default(uuid())
  domain                  String   @unique
  plan                    String   @default("free") // free | pro_29
  seo_score               Int      @default(0)
  auto_optimize_enabled   Boolean  @default(true)
  installed_at            DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model Subscription {
  id                      String    @id @default(uuid())
  shop_domain             String    @unique
  plan_name               String    @default("pro_29") // $29/mo Unlimited Plan
  shopify_subscription_id String?
  status                  String    @default("active") // active | pending | cancelled
  price                   Float     @default(29.0)
  currency                String    @default("USD")
  trial_days              Int       @default(7)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
}

model SeoAudit {
  id                   String   @id @default(uuid())
  shop_domain          String
  health_score         Int      @default(0)
  total_products       Int      @default(0)
  products_fixed       Int      @default(0)
  images_scanned       Int      @default(0)
  images_compressed    Int      @default(0)
  bytes_saved          BigInt   @default(0)
  alt_texts_added      Int      @default(0)
  meta_titles_fixed    Int      @default(0)
  meta_descs_fixed     Int      @default(0)
  schemas_active       Int      @default(0)
  broken_links_found   Int      @default(0)
  last_run_at          DateTime @default(now())
}

model SeoSetting {
  id                      String   @id @default(uuid())
  shop_domain             String   @unique
  product_title_template  String   @default("{product_title} - Buy Online at {shop_name}")
  product_desc_template   String   @default("Buy {product_title} for {price} at {shop_name}. High quality & best prices. Fast shipping!")
  image_alt_template      String   @default("{product_title} - {shop_name}")
  auto_alt_text           Boolean  @default(true)
  auto_compress_images    Boolean  @default(true)
  auto_jsonld_schema      Boolean  @default(true)
  auto_meta_tags          Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model ImageOptLog {
  id            String   @id @default(uuid())
  shop_domain   String
  product_id    String
  image_url     String
  original_size Int
  compressed_size Int
  alt_text      String?
  status        String   @default("compressed") // compressed | optimized
  created_at    DateTime @default(now())
}

model BrokenLink {
  id           String   @id @default(uuid())
  shop_domain  String
  source_url   String
  target_url   String?
  status_code  Int      @default(404)
  fixed        Boolean  @default(false)
  created_at   DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  shop_domain String
  type        String   // auto_scan | image_compress | meta_update | schema_inject | subscribe_29
  payload     String?
  created_at  DateTime @default(now())
}

model PageRecord {
  id              String   @id @default(uuid())
  shop_domain     String
  url             String
  resource_type   String   // product | collection | page | article | home
  resource_gid    String?
  status_code     Int      @default(200)
  last_crawled_at DateTime @default(now())
  created_at      DateTime @default(now())

  @@unique([shop_domain, url])
}

model Issue {
  id             String    @id @default(uuid())
  shop_domain    String
  page_record_id String
  code           String    // missing_title | missing_desc | missing_alt | thin_content | broken_link
  severity       String    // critical | warning | info
  detail         String
  resolved_at    DateTime?
  created_at     DateTime  @default(now())
}

model Verification {
  id             String   @id @default(uuid())
  shop_domain    String
  change_id      String
  result         String   // PASS | FAIL | PENDING
  reason_code    String?  // THEME_DOES_NOT_READ_METAFIELD | OVERWRITTEN_BY_OTHER_APP | CACHE_PENDING | APP_EMBED_DISABLED | PAGE_UNREACHABLE
  observed_value String?
  fetched_url    String
  attempted_at   DateTime @default(now())
}

model Change {
  id           String    @id @default(uuid())
  shop_domain  String
  resource_gid String
  field        String    // title_tag | description_tag | alt | handle | schema
  before_value String?
  after_value  String
  source       String    @default("manual") // manual | autopilot | bulk
  applied_at   DateTime  @default(now())
  reverted_at  DateTime?
}


