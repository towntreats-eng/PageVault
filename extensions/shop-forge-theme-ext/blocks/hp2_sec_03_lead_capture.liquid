{% comment %}
  Shop Forge — HP2 Section 3: Targeted Lead Capture (ConvertFlow Engine)
  Inline multi-step form to capture intent before asking for email.
{% endcomment %}

<div class="sf-lead-engine-wrapper">
  <div class="sf-lead-engine-inner" id="sf-lead-step-1">
    <h3 class="sf-lead-title">Unlock VIP Access & 15% Off</h3>
    <p class="sf-lead-sub">Join the inner circle for early access to new resort collections.</p>
    <button class="sf-lead-btn" onclick="document.getElementById('sf-lead-step-1').style.display='none'; document.getElementById('sf-lead-step-2').style.display='block';">
      YES, GIVE ME 15% OFF
    </button>
    <p class="sf-lead-dismiss">No thanks, I prefer paying full price</p>
  </div>

  <div class="sf-lead-engine-inner" id="sf-lead-step-2" style="display: none;">
    <h3 class="sf-lead-title">Where should we send your discount?</h3>
    <div class="sf-lead-form">
      <input type="email" placeholder="Your best email address" class="sf-lead-input" />
      <button class="sf-lead-btn sf-lead-submit" onclick="this.innerHTML='UNLOCKING...'; setTimeout(() => { document.getElementById('sf-lead-step-2').style.display='none'; document.getElementById('sf-lead-step-3').style.display='block'; }, 1500);">
        REVEAL MY CODE
      </button>
    </div>
  </div>

  <div class="sf-lead-engine-inner" id="sf-lead-step-3" style="display: none;">
    <h3 class="sf-lead-title" style="color: #22c55e;">You're In! 🎉</h3>
    <p class="sf-lead-sub">Use code at checkout to claim your 15% off:</p>
    <div class="sf-lead-code-box">VIPRESORT15</div>
    <a href="#" class="sf-lead-btn" style="display:inline-block; margin-top: 15px; text-decoration:none;">SHOP NOW</a>
  </div>
</div>

<style>
  .sf-lead-engine-wrapper {
    background-color: #f5f3f0;
    padding: 80px 24px;
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
  }
  .sf-lead-engine-inner {
    max-width: 600px;
    margin: 0 auto;
    background: #ffffff;
    padding: 50px 40px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    border: 1px solid #eaeaea;
  }
  .sf-lead-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    margin: 0 0 15px 0;
    color: #1a1a1a;
  }
  .sf-lead-sub {
    font-size: 1.1rem;
    color: #666;
    margin: 0 0 30px 0;
  }
  .sf-lead-btn {
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    padding: 18px 40px;
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 1px;
    border-radius: 40px;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
    width: 100%;
    max-width: 300px;
  }
  .sf-lead-btn:hover {
    background: #4a4a4a;
    transform: translateY(-2px);
  }
  .sf-lead-dismiss {
    margin-top: 15px;
    font-size: 0.8rem;
    color: #999;
    text-decoration: underline;
    cursor: pointer;
  }
  .sf-lead-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: center;
  }
  .sf-lead-input {
    width: 100%;
    max-width: 350px;
    padding: 16px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    outline: none;
  }
  .sf-lead-input:focus {
    border-color: #1a1a1a;
  }
  .sf-lead-submit {
    max-width: 350px;
  }
  .sf-lead-code-box {
    display: inline-block;
    border: 2px dashed #1a1a1a;
    padding: 12px 30px;
    font-size: 1.5rem;
    font-weight: bold;
    letter-spacing: 2px;
    background: #fafafa;
    color: #1a1a1a;
  }
  @media (max-width: 600px) {
    .sf-lead-engine-inner { padding: 40px 20px; }
    .sf-lead-title { font-size: 1.8rem; }
  }
</style>

{% schema %}
{
  "name": "HP2: Lead Capture Engine",
  "target": "section",
  "settings": []
}
{% endschema %}
