{% comment %}
  Shop Forge — HP1 Section 5: Trending Best-Sellers Carousel
{% endcomment %}

<div id="hp1-trending" class="sf-hp1-trending-section">
  <div class="sf-hp1-container">
    <div class="sf-hp1-section-header">
      <span class="sf-hp1-section-tag">TRENDING COLLECTION</span>
      <h2>Most Loved Best Sellers</h2>
      <p>Hand-picked high conversion items backed by thousands of positive customer reviews.</p>
    </div>

    <div class="sf-hp1-product-grid">
      {% assign sample_products = collections.all.products %}
      {% if sample_products.size > 0 %}
        {% for product in sample_products limit: 4 %}
          <div class="sf-hp1-product-card">
            <div class="sf-hp1-card-image-box">
              <span class="sf-hp1-discount-badge">SAVE 40%</span>
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" loading="lazy" class="sf-hp1-prod-img" />
            </div>
            <div class="sf-hp1-card-body">
              <div class="sf-hp1-rating-row">★★★★★ <span>(4.9)</span></div>
              <h3 class="sf-hp1-prod-title">{{ product.title }}</h3>
              <div class="sf-hp1-price-row">
                <span class="sf-hp1-curr-price">{{ product.price | money }}</span>
                <span class="sf-hp1-old-price">{{ product.compare_at_price | money }}</span>
              </div>
              <button type="button" class="sf-hp1-btn-quick-add" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">
                + QUICK ADD TO CART
              </button>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="sf-hp1-product-card">
            <div class="sf-hp1-card-image-box">
              <span class="sf-hp1-discount-badge">SAVE 50%</span>
              <div class="sf-hp1-img-placeholder">📦 Product Image {{ i }}</div>
            </div>
            <div class="sf-hp1-card-body">
              <div class="sf-hp1-rating-row">★★★★★ <span>(4.95)</span></div>
              <h3 class="sf-hp1-prod-title">Flagship D2C Edition {{ i }}</h3>
              <div class="sf-hp1-price-row">
                <span class="sf-hp1-curr-price">₹1,499</span>
                <span class="sf-hp1-old-price">₹2,999</span>
              </div>
              <button type="button" class="sf-hp1-btn-quick-add" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">
                + QUICK ADD TO CART
              </button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-hp1-trending-section {
    background: #0f172a;
    padding: 70px 24px;
    color: #ffffff;
  }
  .sf-hp1-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
  }
  .sf-hp1-product-card {
    background: #1e293b;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sf-hp1-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 35px rgba(0,0,0,0.4);
  }
  .sf-hp1-card-image-box {
    position: relative;
    height: 240px;
    background: #090d16;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sf-hp1-discount-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #ef4444;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 800;
    z-index: 2;
  }
  .sf-hp1-prod-img {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
  }
  .sf-hp1-img-placeholder {
    color: #64748b;
    font-weight: 700;
  }
  .sf-hp1-card-body {
    padding: 20px;
  }
  .sf-hp1-rating-row {
    color: #fbbf24;
    font-size: 0.8rem;
    margin-bottom: 6px;
  }
  .sf-hp1-rating-row span { color: #94a3b8; font-weight: 700; }
  .sf-hp1-prod-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0 0 10px 0;
    color: #f8fafc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sf-hp1-price-row {
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sf-hp1-curr-price {
    font-size: 1.2rem;
    font-weight: 900;
    color: #22c55e;
  }
  .sf-hp1-old-price {
    font-size: 0.85rem;
    color: #64748b;
    text-decoration: line-through;
  }
  .sf-hp1-btn-quick-add {
    width: 100%;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    border: none;
    padding: 12px;
    border-radius: 30px;
    font-weight: 800;
    cursor: pointer;
    font-size: 0.85rem;
  }
</style>

{% schema %}
{
  "name": "HP1: Trending Best-Sellers",
  "target": "section",
  "settings": []
}
{% endschema %}
