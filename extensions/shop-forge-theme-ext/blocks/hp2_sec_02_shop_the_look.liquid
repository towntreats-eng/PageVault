{% comment %}
  Shop Forge — HP2 Section 2: Shop The Look (Premium Hotspot Engine)
  ConvertFlow & Premium Theme inspired interactive product discovery.
{% endcomment %}

<div class="sf-shopthelook-wrapper">
  <div class="sf-shopthelook-header">
    <h2 class="sf-shopthelook-title">{{ block.settings.title | default: "Shop The Curated Look" }}</h2>
    <p class="sf-shopthelook-sub">{{ block.settings.subtitle | default: "Click the hotspots to discover the pieces." }}</p>
  </div>
  
  <div class="sf-shopthelook-container">
    <img src="{{ block.settings.image_url | default: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop' }}" class="sf-shopthelook-img" alt="Shop the look" />
    
    <!-- Hotspot 1 -->
    <div class="sf-hotspot" style="top: 35%; left: 45%;">
      <div class="sf-hotspot-dot"></div>
      <div class="sf-hotspot-card sf-hotspot-right">
        <img src="https://images.unsplash.com/photo-1591561954557-26941169b49e?w=100&h=100&fit=crop" class="sf-hotspot-thumb" />
        <div class="sf-hotspot-info">
          <h4>Classic Silk Blouse</h4>
          <p>₹4,999</p>
          <button class="sf-hotspot-atc">Quick Add</button>
        </div>
      </div>
    </div>

    <!-- Hotspot 2 -->
    <div class="sf-hotspot" style="top: 65%; left: 30%;">
      <div class="sf-hotspot-dot"></div>
      <div class="sf-hotspot-card sf-hotspot-left">
        <img src="https://images.unsplash.com/photo-1584324395345-21d374ce3585?w=100&h=100&fit=crop" class="sf-hotspot-thumb" />
        <div class="sf-hotspot-info">
          <h4>Structured Tote Bag</h4>
          <p>₹8,499</p>
          <button class="sf-hotspot-atc">Quick Add</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sf-shopthelook-wrapper {
    padding: 60px 24px;
    background-color: #ffffff;
    text-align: center;
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
  }
  .sf-shopthelook-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    margin: 0 0 10px 0;
    color: #1a1a1a;
  }
  .sf-shopthelook-sub {
    color: #666;
    margin: 0 0 40px 0;
  }
  .sf-shopthelook-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    display: inline-block;
  }
  .sf-shopthelook-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }
  .sf-hotspot {
    position: absolute;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 10;
  }
  .sf-hotspot-dot {
    width: 24px;
    height: 24px;
    background-color: #ffffff;
    border: 2px solid #1a1a1a;
    border-radius: 50%;
    position: relative;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    transition: transform 0.3s ease;
  }
  .sf-hotspot-dot::after {
    content: '+';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 14px;
    font-weight: bold;
    color: #1a1a1a;
  }
  .sf-hotspot:hover .sf-hotspot-dot {
    transform: scale(1.1);
    background-color: #1a1a1a;
  }
  .sf-hotspot:hover .sf-hotspot-dot::after {
    color: #ffffff;
  }
  .sf-hotspot-card {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #ffffff;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    padding: 12px;
    border-radius: 8px;
    display: flex;
    gap: 12px;
    width: 260px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 20;
  }
  .sf-hotspot-right { left: 40px; transform: translateY(-50%) translateX(10px); }
  .sf-hotspot-left { right: 40px; transform: translateY(-50%) translateX(-10px); }
  
  .sf-hotspot:hover .sf-hotspot-right { opacity: 1; visibility: visible; transform: translateY(-50%) translateX(0); }
  .sf-hotspot:hover .sf-hotspot-left { opacity: 1; visibility: visible; transform: translateY(-50%) translateX(0); }
  
  .sf-hotspot-thumb {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 4px;
  }
  .sf-hotspot-info {
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .sf-hotspot-info h4 {
    margin: 0 0 4px 0;
    font-size: 0.9rem;
    color: #1a1a1a;
  }
  .sf-hotspot-info p {
    margin: 0 0 8px 0;
    font-size: 0.85rem;
    color: #666;
    font-weight: bold;
  }
  .sf-hotspot-atc {
    background: #1a1a1a;
    color: #fff;
    border: none;
    padding: 6px 12px;
    font-size: 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .sf-hotspot-atc:hover { background: #4a4a4a; }
  
  @media (max-width: 600px) {
    .sf-hotspot-card { width: 220px; }
  }
</style>

{% schema %}
{
  "name": "HP2: Shop The Look Engine",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop The Curated Look" },
    { "type": "url", "id": "image_url", "label": "Look Image URL" }
  ]
}
{% endschema %}
