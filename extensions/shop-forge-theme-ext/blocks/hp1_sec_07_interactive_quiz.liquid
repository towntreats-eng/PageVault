{% comment %}
  Shop Forge — HP1 Section 7: Interactive Product Finder Quiz Banner
{% endcomment %}

<div id="hp1-quiz" class="sf-hp1-quiz-section">
  <div class="sf-hp1-container">
    <div class="sf-hp1-quiz-box">
      <span class="sf-hp1-quiz-tag">🎯 30-SECOND PRODUCT FINDER</span>
      <h2>Not Sure Which Product Fits Your Needs?</h2>
      <p>Answer 3 quick questions and get an instant personalized recommendation with a 10% discount code!</p>
      <button type="button" class="sf-hp1-btn-quiz" onclick="alert('Quiz Started! Recommendation: Flagship D2C Edition Pack')">
        START QUIZ NOW →
      </button>
    </div>
  </div>
</div>

<style>
  .sf-hp1-quiz-section {
    background: #0f172a;
    padding: 60px 24px;
  }
  .sf-hp1-quiz-box {
    background: linear-gradient(135deg, #312e81 0%, #1e1b4b 100%);
    border: 1px solid rgba(129, 140, 248, 0.3);
    border-radius: 28px;
    padding: 50px 32px;
    text-align: center;
    color: #ffffff;
    max-width: 860px;
    margin: 0 auto;
  }
  .sf-hp1-quiz-tag {
    background: rgba(255,255,255,0.1);
    color: #a5b4fc;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 800;
  }
  .sf-hp1-quiz-box h2 {
    font-size: 2rem;
    font-weight: 900;
    margin: 16px 0 10px 0;
  }
  .sf-hp1-quiz-box p {
    color: #cbd5e1;
    font-size: 1.05rem;
    margin: 0 0 28px 0;
  }
  .sf-hp1-btn-quiz {
    background: #22c55e;
    color: #000000;
    border: none;
    padding: 16px 36px;
    border-radius: 30px;
    font-weight: 900;
    cursor: pointer;
    font-size: 0.95rem;
  }
</style>

{% schema %}
{
  "name": "HP1: Interactive Quiz Banner",
  "target": "section",
  "settings": []
}
{% endschema %}
