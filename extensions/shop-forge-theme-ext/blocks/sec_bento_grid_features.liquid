{% comment %}
  Shop Forge — CRO Bento Grid Feature Showcase Section
  High-converting bento grid highlighting key product features, USPs, and tech specs.
{% endcomment %}

<div class="sf-bento-grid-section sf-section-padding" style="background-color: {{ block.settings.bg_color }};">
  <div class="sf-container">
    <div class="sf-section-header sf-text-center">
      <span class="sf-badge sf-badge-primary">{{ block.settings.badge_text }}</span>
      <h2 class="sf-title-lg" style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h2>
      <p class="sf-subtitle" style="color: {{ block.settings.text_muted }};">{{ block.settings.subheading }}</p>
    </div>

    <div class="sf-bento-grid">
      <!-- Main Hero Feature Card -->
      <div class="sf-bento-card sf-bento-span-2" style="background-color: {{ block.settings.card_bg }};">
        <div class="sf-bento-content">
          <span class="sf-icon-badge">⚡</span>
          <h3>{{ block.settings.feat1_title }}</h3>
          <p>{{ block.settings.feat1_desc }}</p>
        </div>
      </div>

      <!-- Feature Card 2 -->
      <div class="sf-bento-card" style="background-color: {{ block.settings.card_bg }};">
        <div class="sf-bento-content">
          <span class="sf-icon-badge">🛡️</span>
          <h3>{{ block.settings.feat2_title }}</h3>
          <p>{{ block.settings.feat2_desc }}</p>
        </div>
      </div>

      <!-- Feature Card 3 -->
      <div class="sf-bento-card" style="background-color: {{ block.settings.card_bg }};">
        <div class="sf-bento-content">
          <span class="sf-icon-badge">💎</span>
          <h3>{{ block.settings.feat3_title }}</h3>
          <p>{{ block.settings.feat3_desc }}</p>
        </div>
      </div>

      <!-- Feature Card 4 - Full Width Banner -->
      <div class="sf-bento-card sf-bento-span-2" style="background-color: {{ block.settings.card_bg }};">
        <div class="sf-bento-content sf-flex-between">
          <div>
            <h3>{{ block.settings.feat4_title }}</h3>
            <p>{{ block.settings.feat4_desc }}</p>
          </div>
          {% if block.settings.cta_text != blank %}
            <a href="{{ block.settings.cta_link }}" class="sf-btn sf-btn-primary">{{ block.settings.cta_text }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sf-bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  @media (min-width: 768px) {
    .sf-bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .sf-bento-span-2 {
      grid-column: span 2;
    }
  }
  .sf-bento-card {
    border-radius: 16px;
    padding: 32px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sf-bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }
  .sf-icon-badge {
    font-size: 2rem;
    display: inline-block;
    margin-bottom: 12px;
  }
</style>

{% schema %}
{
  "name": "Bento Grid Features",
  "target": "section",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "WHY CHOOSE US" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered For Peak Performance" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Discover the groundbreaking features that set our product apart." },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#f9fafb" },
    { "type": "color", "id": "card_bg", "label": "Card Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111827" },
    { "type": "color", "id": "text_muted", "label": "Subheading Color", "default": "#6b7280" },
    { "type": "text", "id": "feat1_title", "label": "Feature 1 Title", "default": "Ultra Fast & Lightweight" },
    { "type": "textarea", "id": "feat1_desc", "label": "Feature 1 Description", "default": "Built with aerospace-grade precision for unmatched durability and comfort." },
    { "type": "text", "id": "feat2_title", "label": "Feature 2 Title", "default": "100% Secure & Certified" },
    { "type": "textarea", "id": "feat2_desc", "label": "Feature 2 Description", "default": "Rigorously tested and dermatologist approved for daily use." },
    { "type": "text", "id": "feat3_title", "label": "Feature 3 Title", "default": "Premium Craftsmanship" },
    { "type": "textarea", "id": "feat3_desc", "label": "Feature 3 Description", "default": "Handcrafted materials designed to last for years of active use." },
    { "type": "text", "id": "feat4_title", "label": "Feature 4 Title", "default": "Ready to Transform Your Daily Routine?" },
    { "type": "textarea", "id": "feat4_desc", "label": "Feature 4 Description", "default": "Join over 25,000+ happy customers across India today." },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Shop Now with Free Shipping" },
    { "type": "url", "id": "cta_link", "label": "CTA Button Link" }
  ]
}
{% endschema %}
