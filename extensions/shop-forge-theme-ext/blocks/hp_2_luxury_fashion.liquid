{% comment %}
  Shop Forge — Home Page Template 2: Luxury Fashion & Apparel Editorial
  High-End Fashion & Streetwear Editorial Layout with Split-Screen Hero, Runway Grid & Size Recommender.
{% endcomment %}

<div class="sf-hp2-wrapper">
  <!-- Top Editorial Ticker -->
  <div class="sf-hp2-ticker">
    ✦ NEW SEASON EDIT — COMPLIMENTARY EXPRESS SHIPPING ACROSS INDIA ✦
  </div>

  <!-- Minimalist Navigation Header -->
  <header class="sf-hp2-header">
    <div class="sf-hp2-container sf-hp2-flex-between">
      <div class="sf-hp2-logo">ATELIER D2C</div>
      <nav class="sf-hp2-nav">
        <a href="#">WOMEN</a>
        <a href="#">MEN</a>
        <a href="#">ACCESSORIES</a>
        <a href="#">EDITORIAL</a>
      </nav>
      <div class="sf-hp2-actions">
        <span>❤️ WISHLIST</span>
        <button type="button" class="sf-hp2-btn-bag" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">BAG (0)</button>
      </div>
    </div>
  </header>

  <!-- Split-Screen Lookbook Hero -->
  <section class="sf-hp2-hero">
    <div class="sf-hp2-hero-split">
      <div class="sf-hp2-hero-left">
        <span class="sf-hp2-gold-tag">AUTUMN / WINTER '26</span>
        <h1>UNCOMPROMISING LUXURY FIT & FINISH</h1>
        <p>Crafted from sustainable organic fibers. Designed for effortless elegance and timeless style.</p>
        <a href="#" class="sf-hp2-btn-black">DISCOVER THE COLLECTION →</a>
      </div>
      <div class="sf-hp2-hero-right">
        <div class="sf-hp2-lookbook-box">
          <span>✨ EDITORIAL LOOKBOOK</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Runway Trend Grid -->
  <section class="sf-hp2-section">
    <div class="sf-hp2-container">
      <div class="sf-hp2-section-title">
        <h2>CURATED RUNWAY TRENDS</h2>
        <p>Hand-picked statement pieces for your modern wardrobe</p>
      </div>
      <div class="sf-hp2-grid-4">
        {% for i in (1..4) %}
          <div class="sf-hp2-card">
            <div class="sf-hp2-img-box">
              <span class="sf-hp2-bestseller-badge">NEW ARRIVAL</span>
            </div>
            <div class="sf-hp2-card-info">
              <h3>Signature Tailored Apparel {{ i }}</h3>
              <p>100% Organic Egyptian Cotton</p>
              <div class="sf-hp2-price">₹3,499</div>
              <button type="button" class="sf-hp2-btn-add" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ QUICK ADD</button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

<style>
  .sf-hp2-wrapper { background:#fafaf9; color:#09090b; font-family:'Didot', -apple-system, serif; }
  .sf-hp2-ticker { background:#09090b; color:#d97706; text-align:center; padding:10px; font-size:0.75rem; letter-spacing:2px; font-weight:700; }
  .sf-hp2-header { background:#ffffff; border-bottom:1px solid #e7e5e4; padding:20px 0; }
  .sf-hp2-container { max-width:1200px; margin:0 auto; padding:0 24px; }
  .sf-hp2-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp2-logo { font-size:1.6rem; font-weight:800; letter-spacing:4px; color:#09090b; }
  .sf-hp2-nav a { color:#44403c; text-decoration:none; margin:0 16px; font-size:0.85rem; letter-spacing:1px; font-weight:600; }
  .sf-hp2-btn-bag { background:#09090b; color:#ffffff; border:none; padding:8px 20px; font-size:0.8rem; letter-spacing:1px; cursor:pointer; }
  .sf-hp2-hero-split { display:grid; grid-template-columns:1fr 1fr; min-height:550px; }
  @media(max-width:768px){ .sf-hp2-hero-split { grid-template-columns:1fr; } }
  .sf-hp2-hero-left { background:#f5f5f4; padding:80px 48px; display:flex; flex-direction:column; justify-content:center; }
  .sf-hp2-gold-tag { color:#b45309; font-size:0.8rem; letter-spacing:3px; font-weight:700; margin-bottom:16px; }
  .sf-hp2-hero-left h1 { font-size:2.8rem; font-weight:700; line-height:1.15; margin:0 0 16px 0; letter-spacing:-0.5px; }
  .sf-hp2-hero-left p { font-size:1.05rem; color:#57534e; line-height:1.6; margin:0 0 32px 0; }
  .sf-hp2-btn-black { background:#09090b; color:#ffffff; padding:16px 36px; text-decoration:none; font-size:0.85rem; letter-spacing:2px; font-weight:700; display:inline-block; }
  .sf-hp2-hero-right { background:#e7e5e4; display:flex; align-items:center; justify-content:center; font-size:1.2rem; font-weight:700; letter-spacing:2px; color:#78716c; }
  .sf-hp2-section { padding:80px 0; }
  .sf-hp2-section-title { text-align:center; margin-bottom:48px; }
  .sf-hp2-section-title h2 { font-size:2rem; letter-spacing:2px; margin:0 0 8px 0; }
  .sf-hp2-grid-4 { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:24px; }
  .sf-hp2-card { background:#ffffff; border:1px solid #e7e5e4; text-align:center; padding-bottom:20px; }
  .sf-hp2-img-box { height:300px; background:#f5f5f4; position:relative; }
  .sf-hp2-bestseller-badge { position:absolute; top:12px; left:12px; background:#09090b; color:#fff; font-size:0.65rem; padding:4px 8px; letter-spacing:1px; }
  .sf-hp2-card-info { padding:20px 16px 0 16px; }
  .sf-hp2-card-info h3 { font-size:1rem; margin:0 0 6px 0; }
  .sf-hp2-price { font-size:1.1rem; font-weight:700; margin:10px 0; color:#09090b; }
  .sf-hp2-btn-add { width:100%; background:#ffffff; border:1px solid #09090b; padding:10px; font-size:0.75rem; letter-spacing:1px; font-weight:700; cursor:pointer; }
  .sf-hp2-btn-add:hover { background:#09090b; color:#fff; }
</style>

{% schema %}
{
  "name": "Home Template 2 (Fashion)",
  "target": "section",
  "settings": []
}
{% endschema %}
