{% comment %}
  Shop Forge — CRO High-Impact Flagship Hero Banner Section
  Includes Hero Heading, Dual CTAs, Trust Pill, Live Viewer Badge & Social Proof.
{% endcomment %}

<div class="sf-hero-flagship-wrapper" style="background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};">
  <div class="sf-container sf-hero-grid">
    <!-- Hero Text & CTA Content -->
    <div class="sf-hero-content">
      <div class="sf-hero-live-badge">
        <span class="sf-live-dot"></span>
        <span>🔥 <strong>{{ block.settings.live_viewer_count }} people</strong> viewing this offer right now</span>
      </div>

      <h1 class="sf-hero-heading">{{ block.settings.heading }}</h1>
      <p class="sf-hero-subheading">{{ block.settings.subheading }}</p>

      <div class="sf-hero-actions">
        <a href="{{ block.settings.cta_primary_url }}" class="sf-btn sf-btn-primary sf-btn-lg">
          {{ block.settings.cta_primary_text }} →
        </a>
        {% if block.settings.cta_secondary_text != blank %}
          <a href="{{ block.settings.cta_secondary_url }}" class="sf-btn sf-btn-secondary sf-btn-lg">
            {{ block.settings.cta_secondary_text }}
          </a>
        {% endif %}
      </div>

      <!-- Trust Badges Under Hero CTA -->
      <div class="sf-hero-trust-bar">
        <span>✔ Free Delivery Across India</span>
        <span>✔ Cash On Delivery</span>
        <span>✔ 7-Day Easy Returns</span>
      </div>
    </div>

    <!-- Hero Visual / Showcase Box -->
    <div class="sf-hero-visual-box">
      <div class="sf-hero-image-placeholder">
        <div class="sf-hero-floating-card sf-card-top-left">
          <span>⭐️ 4.9/5 Rating</span>
          <small>Based on 2,400+ D2C Buyers</small>
        </div>

        <div class="sf-hero-visual-center">
          <span style="font-size: 80px;">✨</span>
          <p><strong>Flagship D2C Best-Seller Showcase</strong></p>
        </div>

        <div class="sf-hero-floating-card sf-card-bottom-right">
          <span>⚡ Limited Stock Drop</span>
          <small>Only 8 Items Remaining</small>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sf-hero-flagship-wrapper {
    padding: 60px 0;
    position: relative;
    overflow: hidden;
  }
  .sf-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .sf-hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  .sf-hero-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ecfdf5;
    color: #065f46;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    margin-bottom: 20px;
    border: 1px solid #a7f3d0;
  }
  .sf-live-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    animation: sf-pulse 1.5s infinite;
  }
  @keyframes sf-pulse {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }
  .sf-hero-heading {
    font-size: 2.8rem;
    line-height: 1.15;
    font-weight: 800;
    margin: 0 0 16px 0;
    letter-spacing: -1px;
  }
  @media (max-width: 768px) {
    .sf-hero-heading { font-size: 2rem; }
  }
  .sf-hero-subheading {
    font-size: 1.15rem;
    line-height: 1.5;
    opacity: 0.85;
    margin: 0 0 28px 0;
    max-width: 560px;
  }
  .sf-hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  @media (max-width: 900px) {
    .sf-hero-actions { justify-content: center; }
  }
  .sf-btn-lg {
    padding: 16px 32px;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .sf-hero-trust-bar {
    display: flex;
    gap: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0.8;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .sf-hero-trust-bar { justify-content: center; }
  }
  .sf-hero-visual-box {
    position: relative;
  }
  .sf-hero-image-placeholder {
    height: 420px;
    border-radius: 24px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }
  .sf-hero-floating-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.95);
    color: #111827;
    padding: 12px 18px;
    border-radius: 14px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }
  .sf-card-top-left {
    top: -20px;
    left: -20px;
  }
  .sf-card-bottom-right {
    bottom: -20px;
    right: -20px;
  }
</style>

{% schema %}
{
  "name": "Flagship Hero Banner",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Hero Heading", "default": "Engineered for Maximum D2C Conversions" },
    { "type": "text", "id": "subheading", "label": "Hero Subheading", "default": "Experience high-performing modular storefront design built for rapid growth, high trust, and 1-click checkout." },
    { "type": "text", "id": "live_viewer_count", "label": "Live Viewer Count", "default": "148" },
    { "type": "text", "id": "cta_primary_text", "label": "Primary CTA Text", "default": "SHOP BEST-SELLERS" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA Link", "default": "/collections/all" },
    { "type": "text", "id": "cta_secondary_text", "label": "Secondary CTA Text", "default": "EXPLORE FEATURES" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA Link", "default": "/pages/about" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" }
  ]
}
{% endschema %}
