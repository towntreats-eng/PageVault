{% comment %}
  Shop Forge — As-Seen-On Press & Media Authority Endorsements Bar
  Displays prominent media outlet quotes and logos to instantly establish high authority trust.
{% endcomment %}

<div class="sf-press-section sf-section-padding" style="background-color: {{ block.settings.bg_color }};">
  <div class="sf-container sf-text-center">
    <span class="sf-badge sf-badge-primary">AS SEEN ON</span>
    <h2 class="sf-title-lg" style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h2>

    <div class="sf-press-quotes-grid">
      <div class="sf-press-card">
        <div class="sf-press-logo">VOGUE</div>
        <p class="sf-press-quote">"The breakthrough D2C brand taking India by storm with unmatched product quality."</p>
      </div>

      <div class="sf-press-card">
        <div class="sf-press-logo">GQ</div>
        <p class="sf-press-quote">"A game-changing innovation that seamlessly blends luxury aesthetic with daily performance."</p>
      </div>

      <div class="sf-press-card">
        <div class="sf-press-logo">FORBES</div>
        <p class="sf-press-quote">"Listed among top 10 fastest growing consumer brands built on relentless customer trust."</p>
      </div>
    </div>
  </div>
</div>

<style>
  .sf-press-quotes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 36px;
  }
  .sf-press-card {
    background: #ffffff;
    padding: 28px 24px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    border: 1px solid #f3f4f6;
  }
  .sf-press-logo {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 3px;
    color: #111827;
    margin-bottom: 12px;
  }
  .sf-press-quote {
    font-style: italic;
    color: #4b5563;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }
</style>

{% schema %}
{
  "name": "Press & Media Endorsements",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured in Top Publications" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111827" }
  ]
}
{% endschema %}
