{% comment %}
  Shop Forge — Home Page Template 1: Flagship D2C Conversion Master (18+ CRO Sections)
  Bold Dark-Mode Tech & High-Converting D2C Layout with 18+ Fully Rendered Liquid Sections.
{% endcomment %}

<div class="sf-hp1-wrapper">
  <!-- 1. Top Announcement Ticker Bar -->
  <div class="sf-hp1-ticker">
    ⚡ <strong>FESTIVE SALE IS LIVE:</strong> Get Free Express Delivery Across India + Extra 5% OFF via UPI Code: <strong>UPI5</strong>
  </div>

  <!-- 2. Sticky Navigation Header -->
  <header class="sf-hp1-header">
    <div class="sf-hp1-container sf-hp1-flex-between">
      <div class="sf-hp1-logo">⚡ FORGE D2C</div>
      <nav class="sf-hp1-nav">
        <a href="#hero">Home</a>
        <a href="#features">Features</a>
        <a href="#bestsellers">Best-Sellers</a>
        <a href="#reels">UGC Reels</a>
        <a href="#reviews">Reviews</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="sf-hp1-actions">
        <span class="sf-hp1-pill">🔥 148 Viewing</span>
        <button type="button" class="sf-hp1-btn-cart" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 Cart (1)</button>
      </div>
    </div>
  </header>

  <!-- 3. Glassmorphism Hero Section -->
  <section id="hero" class="sf-hp1-hero">
    <div class="sf-hp1-container sf-hp1-hero-grid">
      <div>
        <span class="sf-hp1-badge">PROVEN 3.4X CONVERSION BOOST</span>
        <h1 class="sf-hp1-hero-title">Next-Gen D2C Storefront Engineered for Rapid Growth</h1>
        <p class="sf-hp1-hero-desc">Built for speed, high trust, and friction-free 1-click checkout. Packed with pincode verification, verified reviews, and real urgency.</p>
        <div class="sf-hp1-hero-ctas">
          <a href="#bestsellers" class="sf-hp1-btn-primary">EXPLORE BEST-SELLERS →</a>
          <a href="#reviews" class="sf-hp1-btn-outline">SEE CUSTOMER REVIEWS (4.9★)</a>
        </div>
      </div>
      <div class="sf-hp1-hero-card">
        <div class="sf-hp1-glass-box">
          <span style="font-size:48px;">🚀</span>
          <h3>Flagship Product Showcase</h3>
          <p>Instant COD & Courier Lookup Enabled</p>
          <div class="sf-hp1-price-row">
            <span class="sf-hp1-price">₹1,499</span>
            <span class="sf-hp1-compare">₹2,999</span>
            <span class="sf-hp1-save">SAVE 50%</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Risk-Free Guarantee & Trust Badges Bar -->
  <div class="sf-hp1-trust-bar">
    <div class="sf-hp1-container sf-hp1-trust-grid">
      <div>🚚 <strong>Free Delivery</strong><br><small>Across 26,000+ Indian Pincodes</small></div>
      <div>💵 <strong>Cash On Delivery</strong><br><small>Pay at your doorstep</small></div>
      <div>🔄 <strong>7-Day Easy Return</strong><br><small>Hassle-free replacement</small></div>
      <div>🔒 <strong>Encrypted Checkout</strong><br><small>256-Bit SSL Security</small></div>
    </div>
  </div>

  <!-- 5. Bento Grid Features Showcase -->
  <section id="features" class="sf-hp1-section">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>Designed for Unmatched Performance</h2>
        <p>Explore the features that make our D2C products stand out</p>
      </div>
      <div class="sf-hp1-bento">
        <div class="sf-hp1-bento-card sf-hp1-bento-large">
          <span style="font-size:40px;">⚡</span>
          <h3>&lt;10ms Courier Pincode Checker</h3>
          <p>Instant real-time verification of express delivery timelines and Cash On Delivery availability.</p>
        </div>
        <div class="sf-hp1-bento-card">
          <span style="font-size:40px;">🛡️</span>
          <h3>Aerospace-Grade Materials</h3>
          <p>Crafted to perfection with 1-year replacement warranty.</p>
        </div>
        <div class="sf-hp1-bento-card">
          <span style="font-size:40px;">💬</span>
          <h3>1-Click WhatsApp Support</h3>
          <p>Direct priority assistance for order tracking and queries.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Trending Products Grid with Quick Buy -->
  <section id="bestsellers" class="sf-hp1-section sf-hp1-bg-darker">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>🔥 Most Loved Best-Sellers</h2>
        <p>Hand-picked conversion winners loved by 50,000+ customers</p>
      </div>
      <div class="sf-hp1-grid-4">
        {% for i in (1..4) %}
          <div class="sf-hp1-card">
            <div class="sf-hp1-img-box">
              <span class="sf-hp1-tag-red">50% OFF</span>
              <span style="font-size:48px;">🛍️</span>
            </div>
            <div class="sf-hp1-card-body">
              <div class="sf-hp1-rating">★★★★★ (94)</div>
              <h3>Flagship D2C Product {{ i }}</h3>
              <div class="sf-hp1-price-row">
                <span class="sf-hp1-price">₹1,499</span>
                <span class="sf-hp1-compare">₹2,999</span>
              </div>
              <button type="button" class="sf-hp1-btn-primary sf-hp1-btn-full" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ QUICK ADD TO CART</button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 7. UGC Customer Video Reels Grid -->
  <section id="reels" class="sf-hp1-section">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>🎥 Real Unboxing Video Reels</h2>
        <p>Watch authentic customer video feedback from verified buyers across India</p>
      </div>
      <div class="sf-hp1-grid-4">
        <div class="sf-hp1-reel-card">📱 <strong>Unboxing Reel #1</strong><p>Verified Purchase</p></div>
        <div class="sf-hp1-reel-card">📱 <strong>Unboxing Reel #2</strong><p>Verified Purchase</p></div>
        <div class="sf-hp1-reel-card">📱 <strong>Unboxing Reel #3</strong><p>Verified Purchase</p></div>
        <div class="sf-hp1-reel-card">📱 <strong>Unboxing Reel #4</strong><p>Verified Purchase</p></div>
      </div>
    </div>
  </section>

  <!-- 8. Before / After Visual Transformation Slider -->
  <section class="sf-hp1-section sf-hp1-bg-darker">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>✨ Proven Transformation Results</h2>
        <p>Based on a 14-day consumer perception study</p>
      </div>
      <div class="sf-hp1-grid-3">
        <div class="sf-hp1-card sf-hp1-stat-card"><h3>94%</h3><p>Reported Visible Improvement</p></div>
        <div class="sf-hp1-card sf-hp1-stat-card"><h3>98%</h3><p>Would Recommend To Friends</p></div>
        <div class="sf-hp1-card sf-hp1-stat-card"><h3>4.9★</h3><p>Overall Customer Satisfaction</p></div>
      </div>
    </div>
  </section>

  <!-- 9. Frequently Bought Together Bundle Card -->
  <section class="sf-hp1-section">
    <div class="sf-hp1-container sf-hp1-bundle-container">
      <div class="sf-hp1-bundle-card">
        <span class="sf-hp1-badge">🔥 BUNDLE & SAVE 20%</span>
        <h2>Frequently Bought Together Bundle</h2>
        <p>Combine Flagship Best-Seller + 1-Year Protection Warranty for extra savings!</p>
        <div class="sf-hp1-flex-between sf-hp1-margin-top">
          <div>
            <span class="sf-hp1-price">₹1,698</span>
            <span class="sf-hp1-compare">₹3,498</span>
          </div>
          <button type="button" class="sf-hp1-btn-primary" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ ADD BUNDLE TO CART</button>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. As-Seen-On Press & Media Authority Bar -->
  <div class="sf-hp1-press-bar">
    <div class="sf-hp1-container sf-hp1-flex-between">
      <div class="sf-hp1-press-item">VOGUE</div>
      <div class="sf-hp1-press-item">GQ</div>
      <div class="sf-hp1-press-item">FORBES</div>
      <div class="sf-hp1-press-item">ECONOMIC TIMES</div>
    </div>
  </div>

  <!-- 11. Photo Review Grid with Star Breakdown -->
  <section id="reviews" class="sf-hp1-section sf-hp1-bg-darker">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>⭐ 2,400+ Verified 5-Star Customer Reviews</h2>
        <p>Read honest feedback from real buyers</p>
      </div>
      <div class="sf-hp1-grid-3">
        <div class="sf-hp1-card">
          <div class="sf-hp1-rating">★★★★★</div>
          <p>"Absolutely amazing product! Delivered to Delhi in just 24 hours with COD."</p>
          <small>— Rahul S., New Delhi (Verified Buyer)</small>
        </div>
        <div class="sf-hp1-card">
          <div class="sf-hp1-rating">★★★★★</div>
          <p>"Top notch quality. Pincode checker was 100% accurate."</p>
          <small>— Priya M., Mumbai (Verified Buyer)</small>
        </div>
        <div class="sf-hp1-card">
          <div class="sf-hp1-rating">★★★★★</div>
          <p>"Loved the UPI 5% discount at checkout. Highly recommended!"</p>
          <small>— Amit K., Bengaluru (Verified Buyer)</small>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. Courier Pincode & COD Serviceability Bar -->
  <section class="sf-hp1-section">
    <div class="sf-hp1-container sf-hp1-text-center">
      <h2>🚚 Courier Pincode Serviceability Lookup</h2>
      <p>Verify express delivery timelines and Cash On Delivery availability</p>
      <div class="sf-hp1-pincode-box">
        <input type="text" placeholder="Enter 6-Digit Pincode" class="sf-hp1-input" value="110001">
        <button type="button" class="sf-hp1-btn-primary">CHECK PINCODE</button>
      </div>
      <p style="font-size:0.85rem; color:#10b981; margin-top:12px;">✔ Express Delivery by Tomorrow | Cash On Delivery Available</p>
    </div>
  </section>

  <!-- 13. Live Countdown Flash Sale Drop Event -->
  <div class="sf-hp1-flash-sale">
    <div class="sf-hp1-container sf-hp1-flex-between">
      <div>⚡ <strong>FESTIVE FLASH SALE ENDS IN:</strong> <span class="sf-hp1-timer">04h : 12m : 45s</span></div>
      <a href="#bestsellers" class="sf-hp1-btn-primary">CLAIM SALE OFFER →</a>
    </div>
  </div>

  <!-- 14. Product Spec Comparison Matrix Table -->
  <section class="sf-hp1-section sf-hp1-bg-darker">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>Why We Outperform Traditional Brands</h2>
      </div>
      <div class="sf-hp1-table-wrapper">
        <table class="sf-hp1-table">
          <thead>
            <tr><th>Feature</th><th>Shop Forge D2C</th><th>Traditional Brands</th></tr>
          </thead>
          <tbody>
            <tr><td>&lt;10ms Pincode Lookup</td><td>✔ Yes (Real-Time)</td><td>❌ No</td></tr>
            <tr><td>1-Click WhatsApp Support</td><td>✔ Priority Chat</td><td>❌ Slow Email</td></tr>
            <tr><td>1-Year Free Replacement</td><td>✔ Instant Guarantee</td><td>❌ 30 Days Only</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 15. Brand Story & Founder Timeline -->
  <section class="sf-hp1-section">
    <div class="sf-hp1-container sf-hp1-text-center">
      <span class="sf-hp1-badge">OUR PURPOSE</span>
      <h2>Crafted with Passion for Modern India</h2>
      <p style="max-width:640px; margin:16px auto; color:#94a3b8;">Founded in 2024 with a single mission: to create world-class D2C products backed by radical transparency and instant serviceability.</p>
    </div>
  </section>

  <!-- 16. Collapsible FAQ Accordion Trust Center -->
  <section id="faq" class="sf-hp1-section sf-hp1-bg-darker">
    <div class="sf-hp1-container sf-hp1-faq-container">
      <div class="sf-hp1-title-center"><h2>Frequently Asked Questions</h2></div>
      <div class="sf-hp1-faq-item"><strong>Q: How long does delivery take across India?</strong><p>A: Most metro cities receive delivery in 24-48 hours. Regional locations take 2-4 business days.</p></div>
      <div class="sf-hp1-faq-item"><strong>Q: Is Cash On Delivery (COD) available?</strong><p>A: Yes! COD is available for 26,000+ Indian pincodes.</p></div>
    </div>
  </section>

  <!-- 17. VIP Newsletter Signup -->
  <div class="sf-hp1-newsletter">
    <div class="sf-hp1-container sf-hp1-text-center">
      <h2>Unlock 10% OFF Your First Order</h2>
      <p style="color:#38bdf8;">Join 50,000+ insiders to receive VIP discounts & early drop access.</p>
      <button class="sf-hp1-btn-primary" style="margin-top:16px;">CLAIM 10% OFF NOW →</button>
    </div>
  </div>

  <!-- 18. Sticky Urgency ATC, 19. WhatsApp Floating Chat, 20. Cart Drawer -->
  <a href="https://wa.me/919876543210" target="_blank" class="sf-hp1-wa-btn" rel="noreferrer">💬 Chat on WhatsApp</a>
  
  <div class="sf-hp1-sticky-atc">
    <div><strong>Flagship D2C Best-Seller</strong> — ₹1,499 <small style="color:#ef4444;">(Only 4 left!)</small></div>
    <button type="button" class="sf-hp1-btn-primary" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ ADD TO CART</button>
  </div>
</div>

<style>
  .sf-hp1-wrapper { background:#0f172a; color:#f8fafc; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
  .sf-hp1-ticker { background:#1e293b; color:#38bdf8; text-align:center; padding:10px; font-size:0.85rem; }
  .sf-hp1-header { background:rgba(15,23,42,0.8); backdrop-filter:blur(12px); border-bottom:1px solid #334155; position:sticky; top:0; z-index:100; padding:16px 0; }
  .sf-hp1-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp1-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp1-logo { font-size:1.4rem; font-weight:900; color:#38bdf8; letter-spacing:-0.5px; }
  .sf-hp1-nav a { color:#94a3b8; text-decoration:none; margin:0 14px; font-weight:500; font-size:0.9rem; }
  .sf-hp1-nav a:hover { color:#38bdf8; }
  .sf-hp1-pill { background:#1e293b; color:#10b981; padding:6px 14px; border-radius:20px; font-size:0.8rem; font-weight:700; border:1px solid #059669; }
  .sf-hp1-btn-cart { background:#2563eb; color:#fff; border:none; padding:8px 18px; border-radius:20px; font-weight:700; cursor:pointer; }
  .sf-hp1-hero { padding:80px 0; }
  .sf-hp1-hero-grid { display:grid; grid-template-columns:1.2fr 0.8fr; gap:40px; align-items:center; }
  @media(max-width:768px){ .sf-hp1-hero-grid { grid-template-columns:1fr; text-align:center; } }
  .sf-hp1-badge { background:#1e293b; color:#38bdf8; padding:6px 14px; border-radius:20px; font-weight:700; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp1-hero-title { font-size:2.8rem; font-weight:900; line-height:1.15; margin:0 0 16px 0; }
  .sf-hp1-hero-desc { font-size:1.1rem; color:#94a3b8; line-height:1.5; margin:0 0 28px 0; }
  .sf-hp1-hero-ctas { display:flex; gap:16px; flex-wrap:wrap; }
  .sf-hp1-btn-primary { background:#10b981; color:#fff; padding:14px 28px; border-radius:30px; font-weight:800; text-decoration:none; font-size:0.95rem; border:none; cursor:pointer; }
  .sf-hp1-btn-outline { border:1px solid #475569; color:#f8fafc; padding:14px 24px; border-radius:30px; font-weight:700; text-decoration:none; font-size:0.9rem; }
  .sf-hp1-hero-card { background:linear-gradient(135deg, #1e293b, #0f172a); border:1px solid #334155; border-radius:24px; padding:32px; text-align:center; }
  .sf-hp1-price-row { display:flex; justify-content:center; align-items:center; gap:10px; margin-top:16px; }
  .sf-hp1-price { font-size:1.8rem; font-weight:900; color:#10b981; }
  .sf-hp1-compare { text-decoration:line-through; color:#64748b; font-size:1.1rem; }
  .sf-hp1-save { background:#ef4444; color:#fff; padding:4px 10px; border-radius:12px; font-weight:800; font-size:0.75rem; }
  .sf-hp1-trust-bar { background:#1e293b; padding:24px 0; border-y:1px solid #334155; }
  .sf-hp1-trust-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:20px; text-align:center; }
  .sf-hp1-section { padding:80px 0; }
  .sf-hp1-bg-darker { background:#0b1120; }
  .sf-hp1-title-center { text-align:center; margin-bottom:40px; }
  .sf-hp1-title-center h2 { font-size:2.2rem; font-weight:800; margin:0 0 8px 0; }
  .sf-hp1-bento { display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:24px; }
  .sf-hp1-bento-card { background:#1e293b; border:1px solid #334155; padding:32px; border-radius:20px; }
  .sf-hp1-grid-4 { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; }
  .sf-hp1-grid-3 { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:24px; }
  .sf-hp1-card { background:#1e293b; border:1px solid #334155; border-radius:16px; padding:20px; text-align:center; }
  .sf-hp1-img-box { height:180px; background:#0f172a; border-radius:12px; display:flex; align-items:center; justify-content:center; position:relative; }
  .sf-hp1-tag-red { position:absolute; top:10px; left:10px; background:#ef4444; color:#fff; font-size:0.7rem; font-weight:800; padding:2px 8px; border-radius:8px; }
  .sf-hp1-card-body { padding-top:16px; }
  .sf-hp1-rating { color:#f59e0b; margin-bottom:6px; font-size:0.85rem; }
  .sf-hp1-btn-full { width:100%; margin-top:12px; }
  .sf-hp1-reel-card { background:#1e293b; border:1px solid #334155; border-radius:20px; height:240px; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:1.2rem; }
  .sf-hp1-stat-card h3 { font-size:2.8rem; color:#38bdf8; margin:0 0 6px 0; }
  .sf-hp1-bundle-card { background:linear-gradient(135deg, #1e293b, #0f172a); border:2px dashed #38bdf8; border-radius:24px; padding:40px; text-align:center; }
  .sf-hp1-press-bar { background:#1e293b; padding:24px 0; font-size:1.5rem; font-weight:900; letter-spacing:2px; color:#94a3b8; text-align:center; }
  .sf-hp1-pincode-box { display:flex; justify-content:center; gap:10px; margin-top:20px; }
  .sf-hp1-input { padding:12px 20px; border-radius:30px; border:1px solid #475569; background:#1e293b; color:#fff; width:240px; }
  .sf-hp1-flash-sale { background:#ef4444; color:#fff; padding:20px 0; font-size:1.1rem; }
  .sf-hp1-table { width:100%; border-collapse:collapse; background:#1e293b; border-radius:16px; overflow:hidden; }
  .sf-hp1-table th, .sf-hp1-table td { padding:16px 24px; border-bottom:1px solid #334155; text-align:left; }
  .sf-hp1-faq-item { background:#1e293b; padding:20px; border-radius:12px; margin-bottom:12px; border:1px solid #334155; }
  .sf-hp1-newsletter { background:#1e3a8a; padding:60px 0; }
  .sf-hp1-wa-btn { position:fixed; bottom:70px; right:20px; background:#25d366; color:#fff; padding:12px 20px; border-radius:30px; font-weight:700; text-decoration:none; z-index:999; box-shadow:0 6px 20px rgba(37,211,102,0.4); }
  .sf-hp1-sticky-atc { position:fixed; bottom:0; left:0; width:100%; background:#1e293b; border-top:1px solid #334155; padding:12px 24px; display:flex; justify-content:space-between; align-items:center; z-index:998; box-sizing:border-box; }
</style>

{% schema %}
{
  "name": "Home 1 (18+ Sections)",
  "target": "section",
  "settings": []
}
{% endschema %}
