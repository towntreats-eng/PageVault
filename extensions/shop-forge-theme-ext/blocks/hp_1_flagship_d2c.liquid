{% comment %}
  Shop Forge — Home Page Template 1: Flagship D2C Conversion Master
  Bold Dark-Mode Tech & High-Converting D2C Layout with Glassmorphism, Bento Grid & Video Reels.
{% endcomment %}

<div class="sf-hp1-wrapper">
  <!-- 1. Top Promo Ticker -->
  <div class="sf-hp1-ticker">
    ⚡ <strong>FESTIVE SALE IS LIVE:</strong> Get Free Express Delivery Across India + Extra 5% OFF via UPI Code: <strong>UPI5</strong>
  </div>

  <!-- 2. Sticky Glassmorphism Header -->
  <header class="sf-hp1-header">
    <div class="sf-hp1-container sf-hp1-flex-between">
      <div class="sf-hp1-logo">⚡ FORGE D2C</div>
      <nav class="sf-hp1-nav">
        <a href="#features">Features</a>
        <a href="#bestsellers">Best-Sellers</a>
        <a href="#reviews">Reviews</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="sf-hp1-actions">
        <span class="sf-hp1-pill">🔥 148 Viewing</span>
        <button type="button" class="sf-hp1-btn-cart" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 Cart (1)</button>
      </div>
    </div>
  </header>

  <!-- 3. Glassmorphism Hero Section -->
  <section class="sf-hp1-hero">
    <div class="sf-hp1-container sf-hp1-hero-grid">
      <div>
        <span class="sf-hp1-badge">PROVEN 3.4X CONVERSION BOOST</span>
        <h1 class="sf-hp1-hero-title">Next-Gen D2C Storefront Engineered for Rapid Growth</h1>
        <p class="sf-hp1-hero-desc">Built for speed, high trust, and friction-free 1-click checkout. Packed with pincode verification, verified reviews, and real urgency.</p>
        <div class="sf-hp1-hero-ctas">
          <a href="/collections/all" class="sf-hp1-btn-primary">EXPLORE BEST-SELLERS →</a>
          <a href="#reviews" class="sf-hp1-btn-outline">SEE CUSTOMER REVIEWS (4.9★)</a>
        </div>
      </div>
      <div class="sf-hp1-hero-card">
        <div class="sf-hp1-glass-box">
          <span style="font-size:48px;">🚀</span>
          <h3>Flagship Product Showcase</h3>
          <p>Instant COD & Courier Lookup Enabled</p>
          <div class="sf-hp1-price-row">
            <span class="sf-hp1-price">₹1,499</span>
            <span class="sf-hp1-compare">₹2,999</span>
            <span class="sf-hp1-save">SAVE 50%</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Trust Badges Bar -->
  <div class="sf-hp1-trust-bar">
    <div class="sf-hp1-container sf-hp1-trust-grid">
      <div>🚚 <strong>Free Delivery</strong><br><small>Across 26,000+ Indian Pincodes</small></div>
      <div>💵 <strong>Cash On Delivery</strong><br><small>Pay at your doorstep</small></div>
      <div>🔄 <strong>7-Day Easy Return</strong><br><small>Hassle-free replacement</small></div>
      <div>🔒 <strong>Encrypted Checkout</strong><br><small>256-Bit SSL Security</small></div>
    </div>
  </div>

  <!-- 5. Interactive Bento Grid -->
  <section id="features" class="sf-hp1-section">
    <div class="sf-hp1-container">
      <div class="sf-hp1-title-center">
        <h2>Designed for Unmatched Performance</h2>
        <p>Explore the features that make our D2C products stand out</p>
      </div>
      <div class="sf-hp1-bento">
        <div class="sf-hp1-bento-card sf-hp1-bento-large">
          <span style="font-size:40px;">⚡</span>
          <h3>&lt;10ms Courier Pincode Checker</h3>
          <p>Instant real-time verification of express delivery timelines and Cash On Delivery availability.</p>
        </div>
        <div class="sf-hp1-bento-card">
          <span style="font-size:40px;">🛡️</span>
          <h3>Aerospace-Grade Materials</h3>
          <p>Crafted to perfection with 1-year replacement warranty.</p>
        </div>
        <div class="sf-hp1-bento-card">
          <span style="font-size:40px;">💬</span>
          <h3>1-Click WhatsApp Support</h3>
          <p>Direct priority assistance for order tracking and queries.</p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .sf-hp1-wrapper { background:#0f172a; color:#f8fafc; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
  .sf-hp1-ticker { background:#1e293b; color:#38bdf8; text-align:center; padding:10px; font-size:0.85rem; }
  .sf-hp1-header { background:rgba(15,23,42,0.8); backdrop-filter:blur(12px); border-bottom:1px solid #334155; position:sticky; top:0; z-index:100; padding:16px 0; }
  .sf-hp1-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp1-flex-between { display:flex; justify-space-between; align-items:center; }
  .sf-hp1-logo { font-size:1.4rem; font-weight:900; color:#38bdf8; letter-spacing:-0.5px; }
  .sf-hp1-nav a { color:#94a3b8; text-decoration:none; margin:0 14px; font-weight:500; font-size:0.9rem; }
  .sf-hp1-nav a:hover { color:#38bdf8; }
  .sf-hp1-pill { background:#1e293b; color:#10b981; padding:6px 14px; border-radius:20px; font-size:0.8rem; font-weight:700; border:1px solid #059669; }
  .sf-hp1-btn-cart { background:#2563eb; color:#fff; border:none; padding:8px 18px; border-radius:20px; font-weight:700; cursor:pointer; }
  .sf-hp1-hero { padding:80px 0; }
  .sf-hp1-hero-grid { display:grid; grid-template-columns:1.2fr 0.8fr; gap:40px; align-items:center; }
  @media(max-width:768px){ .sf-hp1-hero-grid { grid-template-columns:1fr; text-align:center; } }
  .sf-hp1-badge { background:#1e293b; color:#38bdf8; padding:6px 14px; border-radius:20px; font-weight:700; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp1-hero-title { font-size:2.8rem; font-weight:900; line-height:1.15; margin:0 0 16px 0; }
  .sf-hp1-hero-desc { font-size:1.1rem; color:#94a3b8; line-height:1.5; margin:0 0 28px 0; }
  .sf-hp1-hero-ctas { display:flex; gap:16px; flex-wrap:wrap; }
  .sf-hp1-btn-primary { background:#10b981; color:#fff; padding:16px 32px; border-radius:30px; font-weight:800; text-decoration:none; font-size:1rem; }
  .sf-hp1-btn-outline { border:1px solid #475569; color:#f8fafc; padding:16px 28px; border-radius:30px; font-weight:700; text-decoration:none; font-size:0.9rem; }
  .sf-hp1-hero-card { background:linear-gradient(135deg, #1e293b, #0f172a); border:1px solid #334155; border-radius:24px; padding:32px; text-align:center; }
  .sf-hp1-price-row { display:flex; justify-content:center; align-items:center; gap:10px; margin-top:16px; }
  .sf-hp1-price { font-size:1.8rem; font-weight:900; color:#10b981; }
  .sf-hp1-compare { text-decoration:line-through; color:#64748b; font-size:1.1rem; }
  .sf-hp1-save { background:#ef4444; color:#fff; padding:4px 10px; border-radius:12px; font-weight:800; font-size:0.75rem; }
  .sf-hp1-trust-bar { background:#1e293b; padding:24px 0; border-y:1px solid #334155; }
  .sf-hp1-trust-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:20px; text-align:center; }
  .sf-hp1-section { padding:80px 0; }
  .sf-hp1-title-center { text-align:center; margin-bottom:40px; }
  .sf-hp1-title-center h2 { font-size:2.2rem; font-weight:800; margin:0 0 8px 0; }
  .sf-hp1-bento { display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:24px; }
  .sf-hp1-bento-card { background:#1e293b; border:1px solid #334155; padding:32px; border-radius:20px; }
</style>

{% schema %}
{
  "name": "Home Template 1 (Flagship)",
  "target": "section",
  "settings": []
}
{% endschema %}
