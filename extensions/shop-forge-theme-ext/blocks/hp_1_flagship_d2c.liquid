{% comment %}
  Shop Forge — Home Page Template 1: Flagship D2C Conversion Master (18+ Sections)
  Composed of modular section blocks:
  1. Hero Glassmorphism (hp1_sec_01_hero)
  2. Announcement Ticker (hp1_sec_02_announcement)
  3. Trust Badges Grid (hp1_sec_03_trust_badges)
  4. Bento Feature Grid (hp1_sec_04_bento_grid)
  5. Trending Carousel (hp1_sec_05_trending_carousel)
  6. Shoppable Video Reels (hp1_sec_06_video_reels)
  7. Interactive Quiz Banner (hp1_sec_07_interactive_quiz)
  8. Comparison Table (hp1_sec_08_comparison_table)
  9. Customer Reviews Grid (hp1_sec_09_customer_reviews)
  10. Press Bar (hp1_sec_10_press_bar)
  11. FAQ Accordion (hp1_sec_11_faq_accordion)
  12. Sticky ATC Bar (hp1_sec_12_sticky_atc)
{% endcomment %}

<div class="sf-hp1-master-wrapper">
  {% render 'hp1_sec_01_hero' %}
  {% render 'hp1_sec_02_announcement' %}
  {% render 'hp1_sec_03_trust_badges' %}
  {% render 'hp1_sec_04_bento_grid' %}
  {% render 'hp1_sec_05_trending_carousel' %}
  {% render 'hp1_sec_06_video_reels' %}
  {% render 'hp1_sec_07_interactive_quiz' %}
  {% render 'hp1_sec_08_comparison_table' %}
  {% render 'hp1_sec_09_customer_reviews' %}
  {% render 'hp1_sec_10_press_bar' %}
  {% render 'hp1_sec_11_faq_accordion' %}
  {% render 'hp1_sec_12_sticky_atc' %}
</div>

{% schema %}
{
  "name": "Home 1 (Flagship D2C)",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flagship D2C Master Template" }
  ]
}
{% endschema %}
