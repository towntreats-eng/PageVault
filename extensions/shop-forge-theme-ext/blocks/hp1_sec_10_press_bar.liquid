{% comment %}
  Shop Forge — HP1 Section 10: Press & Media Feature Bar
{% endcomment %}

<div class="sf-hp1-press-section">
  <div class="sf-hp1-container">
    <div class="sf-hp1-press-label">AS FEATURED IN TOP LEADING PUBLICATIONS</div>
    <div class="sf-hp1-press-grid">
      <div class="sf-hp1-press-logo">VOGUE</div>
      <div class="sf-hp1-press-logo">TECHCRUNCH</div>
      <div class="sf-hp1-press-logo">FORBES</div>
      <div class="sf-hp1-press-logo">GQ</div>
      <div class="sf-hp1-press-logo">BUSINESS STANDARD</div>
    </div>
  </div>
</div>

<style>
  .sf-hp1-press-section {
    background: #020617;
    padding: 36px 24px;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    text-align: center;
  }
  .sf-hp1-press-label {
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 20px;
  }
  .sf-hp1-press-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .sf-hp1-press-logo {
    color: #94a3b8;
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 2px;
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "HP1: Press & Media Bar",
  "target": "section",
  "settings": []
}
{% endschema %}
