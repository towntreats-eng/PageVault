{% comment %}
  Shop Forge — HP1 Section 8: Comparison Specs Table (Us vs Cheap Knockoffs)
{% endcomment %}

<div class="sf-hp1-comp-section">
  <div class="sf-hp1-container">
    <div class="sf-hp1-section-header">
      <span class="sf-hp1-section-tag">UNCOMPROMISING QUALITY</span>
      <h2>Shop Forge vs Traditional Market Alternatives</h2>
    </div>

    <div class="sf-hp1-table-wrapper">
      <table class="sf-hp1-comp-table">
        <thead>
          <tr>
            <th>FEATURE / SPECIFICATION</th>
            <th class="sf-hp1-highlight-col">💎 SHOP FORGE D2C</th>
            <th>❌ CHEAP MARKET KNOCKOFFS</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Build & Material Quality</td>
            <td class="sf-hp1-highlight-col">✔ Aerospace-Grade & Tested</td>
            <td>❌ Recycled Cheap Plastics</td>
          </tr>
          <tr>
            <td>Warranty Coverage</td>
            <td class="sf-hp1-highlight-col">✔ 1-Year Instant Replacement</td>
            <td>❌ No Warranty / Refused Claims</td>
          </tr>
          <tr>
            <td>India Pincode COD Delivery</td>
            <td class="sf-hp1-highlight-col">✔ 26,000+ Pincodes Covered</td>
            <td>❌ Prepaid Only / High RTO Fees</td>
          </tr>
          <tr>
            <td>Customer Support Speed</td>
            <td class="sf-hp1-highlight-col">✔ 24/7 Dedicated WhatsApp Chat</td>
            <td>❌ No Phone Support / Email Delay</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .sf-hp1-comp-section {
    background: #020617;
    padding: 70px 24px;
    color: #ffffff;
  }
  .sf-hp1-table-wrapper {
    max-width: 900px;
    margin: 0 auto;
    overflow-x: auto;
  }
  .sf-hp1-comp-table {
    width: 100%;
    border-collapse: collapse;
    background: #0f172a;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .sf-hp1-comp-table th, .sf-hp1-comp-table td {
    padding: 18px 24px;
    text-align: left;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 0.9rem;
  }
  .sf-hp1-comp-table th {
    background: #1e293b;
    font-weight: 800;
    color: #f8fafc;
  }
  .sf-hp1-highlight-col {
    background: rgba(99, 102, 241, 0.12) !important;
    color: #818cf8 !important;
    font-weight: 800;
  }
</style>

{% schema %}
{
  "name": "HP1: Comparison Table",
  "target": "section",
  "settings": []
}
{% endschema %}
