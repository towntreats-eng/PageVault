{% comment %}
  Shop Forge — FAQ & Trust Center Page Block
  Full Page Catalog Item | Token-driven & Mobile First
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shop-forge-blocks.js' | asset_url }}" defer></script>

<div class="sf-block-root" id="sf-faq-{{ block.id }}">
  <div style="max-width: 800px; margin: 0 auto; padding: 20px 16px;">
    <div style="text-align: center; margin-bottom: 36px;">
      <span class="sf-badge sf-badge-green">Help & Trust Center</span>
      <h1 style="font-size: 2.25rem; font-weight: 900; margin: 8px 0;">
        {{ block.settings.title | default: "Frequently Asked Questions" }}
      </h1>
      <p style="color: #64748b; margin: 0;">Everything you need to know about ordering, shipping, COD, and returns.</p>
    </div>

    <!-- Accordion List -->
    <div style="display: flex; flex-direction: column; gap: 12px;">
      <div class="sf-faq-item sf-pincode-card" style="padding: 16px 20px;">
        <div class="sf-faq-question" style="font-weight: 700; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
          <span>🚚 What are the delivery timelines and COD options across India?</span>
          <span class="sf-faq-icon" style="font-size: 1.25rem; font-weight: 800; color: #3b82f6;">+</span>
        </div>
        <div class="sf-faq-answer" style="display: none; margin-top: 12px; font-size: 0.9rem; color: #475569; line-height: 1.6;">
          We ship all orders via priority air courier (BlueDart, Delhivery, DTDC). Metro cities receive orders within 2 to 3 business days. Non-metro locations take 4 to 5 business days. Cash on Delivery (COD) is available on all pin codes nationwide.
        </div>
      </div>

      <div class="sf-faq-item sf-pincode-card" style="padding: 16px 20px;">
        <div class="sf-faq-question" style="font-weight: 700; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
          <span>🔄 What is your return & exchange policy?</span>
          <span class="sf-faq-icon" style="font-size: 1.25rem; font-weight: 800; color: #3b82f6;">+</span>
        </div>
        <div class="sf-faq-answer" style="display: none; margin-top: 12px; font-size: 0.9rem; color: #475569; line-height: 1.6;">
          We offer a 7-day hassle-free return and replacement policy. If you receive a damaged or incorrect item, click the WhatsApp support button to initiate an instant replacement with free pickup.
        </div>
      </div>

      <div class="sf-faq-item sf-pincode-card" style="padding: 16px 20px;">
        <div class="sf-faq-question" style="font-weight: 700; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
          <span>🛡️ Are products covered under warranty?</span>
          <span class="sf-faq-icon" style="font-size: 1.25rem; font-weight: 800; color: #3b82f6;">+</span>
        </div>
        <div class="sf-faq-answer" style="display: none; margin-top: 12px; font-size: 0.9rem; color: #475569; line-height: 1.6;">
          Yes! Every product comes with a 1-year standard manufacturer warranty covering defects and performance issues.
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF FAQ & Trust Center",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Frequently Asked Questions"
    }
  ]
}
{% endschema %}
