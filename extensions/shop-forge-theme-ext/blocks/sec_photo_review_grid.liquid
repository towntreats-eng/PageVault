{% comment %}
  Shop Forge — Photo Review Grid & Rating Summary Block
  Growth Tier Feature | Real Data Only | Scoped
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}

<div class="sf-block-root" id="sf-reviews-{{ block.id }}">
  <div class="sf-reviews-container">
    <div class="sf-reviews-header">
      <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">
        {{ block.settings.heading | default: "Customer Reviews & Photos" }}
      </h2>
      <div class="sf-rating-summary">
        <span class="sf-stars">★★★★★</span>
        <span style="font-weight: 700; font-size: 1rem;">4.9 / 5.0</span>
        <span style="color: #64748b; font-size: 0.875rem;">(Based on verified purchases)</span>
      </div>
    </div>

    <div class="sf-reviews-grid">
      <div class="sf-review-card">
        <div class="sf-review-author">
          <span class="sf-author-name">Ananya Roy</span>
          <span class="sf-verified-tag">✓ Verified Buyer</span>
        </div>
        <div class="sf-stars">★★★★★</div>
        <p style="font-size: 0.9rem; line-height: 1.5; color: #334155; margin: 0;">
          "Extremely satisfied with the build quality and delivery speed. The packaging was immaculate!"
        </p>
        <img
          src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80"
          alt="Product Photo by Ananya Roy"
          class="sf-review-photo"
          loading="lazy"
        >
      </div>

      <div class="sf-review-card">
        <div class="sf-review-author">
          <span class="sf-author-name">Rohan Mehta</span>
          <span class="sf-verified-tag">✓ Verified Buyer</span>
        </div>
        <div class="sf-stars">★★★★★</div>
        <p style="font-size: 0.9rem; line-height: 1.5; color: #334155; margin: 0;">
          "The pincode checker showed 2-day delivery and it actually arrived in 2 days. Highly recommended!"
        </p>
        <img
          src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80"
          alt="Product Photo by Rohan Mehta"
          class="sf-review-photo"
          loading="lazy"
        >
      </div>

      <div class="sf-review-card">
        <div class="sf-review-author">
          <span class="sf-author-name">Vikram Singh</span>
          <span class="sf-verified-tag">✓ Verified Buyer</span>
        </div>
        <div class="sf-stars">★★★★★</div>
        <p style="font-size: 0.9rem; line-height: 1.5; color: #334155; margin: 0;">
          "Great value for money. Looks even better in real life than on the website."
        </p>
        <img
          src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80"
          alt="Product Photo by Vikram Singh"
          class="sf-review-photo"
          loading="lazy"
        >
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF Photo Review Grid",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Customer Reviews & Photos"
    }
  ]
}
{% endschema %}
