{% comment %}
  Shop Forge — Flash Sale / Drop Event Page Block
  Full Page Catalog Item | Token-driven & Mobile First
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}

<div class="sf-block-root" id="sf-flash-{{ block.id }}">
  <div style="background: #9a3412; color: #ffffff; padding: 24px; text-align: center; border-radius: var(--sf-border-radius); margin-bottom: 32px;">
    <span class="sf-badge sf-badge-orange" style="background: #ffffff; color: #9a3412; font-weight: 800;">
      🔥 LIMITED TIME FLASH SALE
    </span>
    <h1 style="font-size: 2rem; font-weight: 900; margin: 12px 0;">
      {{ block.settings.title | default: "Midnight Drop — Flat 50% Off Everything" }}
    </h1>
    <div style="font-size: 1.2rem; font-weight: 800; letter-spacing: 2px;">
      ENDS IN: 04h : 18m : 42s
    </div>
  </div>

  <div class="sf-reviews-grid">
    <div class="sf-review-card">
      <div style="position: relative;">
        <span class="sf-badge sf-badge-orange" style="position: absolute; top: 10px; left: 10px;">50% OFF</span>
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80" style="width: 100%; height: 220px; object-fit: cover; border-radius: 8px;">
      </div>
      <div style="font-weight: 800; font-size: 1.1rem;">Flash Edition Watch</div>
      <div style="display: flex; gap: 8px; align-items: baseline;">
        <span style="font-weight: 800; font-size: 1.25rem;">₹1,249</span>
        <span style="text-decoration: line-through; color: #94a3b8;">₹2,499</span>
      </div>
      <button type="button" class="sf-sticky-btn" style="width: 100%; margin-top: 8px; background: #9a3412;">
        Claim Flash Deal
      </button>
    </div>

    <div class="sf-review-card">
      <div style="position: relative;">
        <span class="sf-badge sf-badge-orange" style="position: absolute; top: 10px; left: 10px;">50% OFF</span>
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80" style="width: 100%; height: 220px; object-fit: cover; border-radius: 8px;">
      </div>
      <div style="font-weight: 800; font-size: 1.1rem;">ANC Wireless Earbuds</div>
      <div style="display: flex; gap: 8px; align-items: baseline;">
        <span style="font-weight: 800; font-size: 1.25rem;">₹2,499</span>
        <span style="text-decoration: line-through; color: #94a3b8;">₹4,999</span>
      </div>
      <button type="button" class="sf-sticky-btn" style="width: 100%; margin-top: 8px; background: #9a3412;">
        Claim Flash Deal
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF Flash Sale Drop",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Flash Sale Event Title",
      "default": "Midnight Drop — Flat 50% Off Everything"
    }
  ]
}
{% endschema %}
