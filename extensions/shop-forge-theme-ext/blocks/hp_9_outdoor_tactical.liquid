{% comment %}
  Shop Forge — Home Page Template 9: Outdoor, Adventure & Tactical Gear
  Rugged Forest Green & Charcoal Layout for Travel, Camping & Outdoor D2C Brands.
{% endcomment %}

<div class="sf-hp9-wrapper">
  <div class="sf-hp9-ticker">🏕️ ALL-WEATHER WATERPROOF GEAR — MIL-SPEC TESTED FOR EXTREME ADVENTURES</div>
  <header class="sf-hp9-header">
    <div class="sf-hp9-container sf-hp9-flex-between">
      <div class="sf-hp9-logo">TUNDRA <span>GEAR</span></div>
      <nav class="sf-hp9-nav"><a href="#hero">Tents</a><a href="#backpacks">Backpacks</a><a href="#reviews">Reviews</a></nav>
      <button type="button" class="sf-hp9-btn-green" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 MY GEAR (0)</button>
    </div>
  </header>
  <section id="hero" class="sf-hp9-hero">
    <div class="sf-hp9-container sf-hp9-hero-grid">
      <div>
        <span class="sf-hp9-tag">⛰️ MIL-SPEC RUGGEDNESS</span>
        <h1>BUILT FOR UNTAMED TRAILS & EXTREME CLIMATES</h1>
        <p>Waterproof 1000D Cordura fabric, reinforced zippers, and 5-year expedition guarantee.</p>
        <a href="#backpacks" class="sf-hp9-btn-hero">EXPLORE TACTICAL GEAR →</a>
      </div>
      <div class="sf-hp9-hero-box"><span>🎒 45L Tactical Expedition Rucksack</span></div>
    </div>
  </section>
  <section id="backpacks" class="sf-hp9-section">
    <div class="sf-hp9-container sf-hp9-title-center">
      <h2>🎒 EXPEDITION-READY GEAR</h2>
      <div class="sf-hp9-grid-4">
        {% for i in (1..4) %}
          <div class="sf-hp9-card">
            <div style="font-size:40px;">🎒</div>
            <h3>Tactical Rucksack {{ i }}</h3>
            <p style="color:#22c55e; font-weight:800;">₹4,499 <span style="text-decoration:line-through; color:#64748b;">₹6,999</span></p>
            <button type="button" class="sf-hp9-btn-green" style="width:100%;" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ ADD TO CART</button>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>
<style>
  .sf-hp9-wrapper { background:#0f172a; color:#f8fafc; font-family:-apple-system,sans-serif; }
  .sf-hp9-ticker { background:#15803d; color:#fff; text-align:center; padding:10px; font-size:0.8rem; font-weight:800; }
  .sf-hp9-header { background:#1e293b; border-b:1px solid #334155; padding:16px 0; position:sticky; top:0; z-index:100; }
  .sf-hp9-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp9-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp9-logo { font-size:1.5rem; font-weight:900; color:#22c55e; }
  .sf-hp9-logo span { color:#fff; font-weight:400; }
  .sf-hp9-nav a { color:#94a3b8; text-decoration:none; margin:0 14px; font-weight:600; font-size:0.9rem; }
  .sf-hp9-btn-green { background:#22c55e; color:#000; border:none; padding:10px 22px; border-radius:20px; font-weight:800; cursor:pointer; }
  .sf-hp9-hero { padding:80px 0; background:linear-gradient(135deg, #052e16, #0f172a); }
  .sf-hp9-hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; }
  .sf-hp9-tag { background:#1e293b; color:#22c55e; padding:6px 14px; border-radius:20px; font-weight:800; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp9-hero h1 { font-size:2.5rem; font-weight:900; margin:0 0 16px 0; }
  .sf-hp9-hero p { font-size:1.1rem; color:#94a3b8; margin:0 0 28px 0; }
  .sf-hp9-btn-hero { background:#22c55e; color:#000; padding:16px 32px; border-radius:30px; font-weight:900; text-decoration:none; display:inline-block; }
  .sf-hp9-hero-box { height:320px; background:#1e293b; border-radius:24px; display:flex; align-items:center; justify-content:center; font-weight:700; color:#22c55e; border:1px solid #334155; }
  .sf-hp9-section { padding:64px 0; }
  .sf-hp9-title-center { text-align:center; }
  .sf-hp9-grid-4 { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-top:32px; }
  .sf-hp9-card { background:#1e293b; border:1px solid #334155; padding:24px; border-radius:20px; text-align:center; }
</style>
{% schema %} { "name": "Home 9 (Outdoor Gear)", "target": "section", "settings": [] } {% endschema %}
