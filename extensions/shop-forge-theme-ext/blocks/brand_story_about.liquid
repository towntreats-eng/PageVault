{% comment %}
  Shop Forge — Brand Story & Founder About Page Block
  Full Page Catalog Item | Token-driven & Mobile First
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}

<div class="sf-block-root" id="sf-about-{{ block.id }}">
  <div style="max-width: 900px; margin: 0 auto; padding: 40px 16px;">
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="sf-badge sf-badge-green">Our Journey & Mission</span>
      <h1 style="font-size: 2.25rem; font-weight: 900; margin: 12px 0;">
        {{ block.settings.title | default: "Crafting Excellence Since Day One" }}
      </h1>
      <p style="font-size: 1.1rem; color: #475569; max-width: 650px; margin: 0 auto;">
        We started with a simple belief: high quality shouldn't come with insane markups. Here's how we build products that last a lifetime.
      </p>
    </div>

    <!-- Founder Note Card -->
    <div class="sf-pincode-card" style="padding: 32px; background: #f8fafc; margin-bottom: 40px;">
      <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
        <img
          src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=80"
          alt="Founder Portrait"
          style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover;"
        >
        <div style="flex: 1;">
          <h3 style="margin: 0; font-size: 1.2rem; font-weight: 800;">A Note From Our Founder</h3>
          <p style="color: #475569; line-height: 1.6; font-size: 0.95rem; margin-top: 8px;">
            "We built this brand out of frustration with disposable products. Every piece we make undergoes 50+ durability tests before it ever reaches your hands."
          </p>
          <div style="font-weight: 700; color: #0f172a; font-size: 0.9rem;">— Umang & The Design Team</div>
        </div>
      </div>
    </div>

    <!-- Brand Values Grid -->
    <div class="sf-reviews-grid">
      <div class="sf-review-card" style="text-align: center; align-items: center;">
        <div style="font-size: 2rem;">🌿</div>
        <h3 style="font-weight: 800; margin: 0;">Sustainable Sourcing</h3>
        <p style="font-size: 0.875rem; color: #64748b; margin: 0;">Ethically harvested eco-friendly raw materials.</p>
      </div>

      <div class="sf-review-card" style="text-align: center; align-items: center;">
        <div style="font-size: 2rem;">🔍</div>
        <h3 style="font-weight: 800; margin: 0;">Transparent Pricing</h3>
        <p style="font-size: 0.875rem; color: #64748b; margin: 0;">Zero middleman markup, passed directly to you.</p>
      </div>

      <div class="sf-review-card" style="text-align: center; align-items: center;">
        <div style="font-size: 2rem;">🤝</div>
        <h3 style="font-weight: 800; margin: 0;">Made In India</h3>
        <p style="font-size: 0.875rem; color: #64748b; margin: 0;">Supporting skilled local artisans & craftspeople.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF Brand Story & About",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Crafting Excellence Since Day One"
    }
  ]
}
{% endschema %}
