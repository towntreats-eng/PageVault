{% comment %}
  Shop Forge — Sticky Navigation Header & Announcement Ticker Bar
  High-converting header with promo ticker, search, wishlist counter & cart badge.
{% endcomment %}

<div class="sf-header-wrapper">
  <!-- Top Promo Announcement Ticker Bar -->
  <div class="sf-ticker-bar" style="background-color: {{ block.settings.ticker_bg }}; color: {{ block.settings.ticker_text_color }};">
    <div class="sf-container sf-flex-between">
      <div class="sf-ticker-text">
        ⚡ <span>{{ block.settings.ticker_msg_1 }}</span>
      </div>
      <div class="sf-ticker-sub-info">
        <span>{{ block.settings.ticker_msg_2 }}</span>
      </div>
    </div>
  </div>

  <!-- Sticky Main Header -->
  <header class="sf-main-header" style="background-color: {{ block.settings.header_bg }}; color: {{ block.settings.header_text_color }};">
    <div class="sf-container sf-flex-between sf-align-center">
      <!-- Mobile Menu Toggle -->
      <button type="button" class="sf-mobile-menu-toggle" aria-label="Toggle Navigation">
        ☰
      </button>

      <!-- Brand Logo -->
      <div class="sf-logo">
        <a href="/" style="color: {{ block.settings.header_text_color }};">
          {% if block.settings.logo_text != blank %}
            <strong>{{ block.settings.logo_text }}</strong>
          {% else %}
            <strong>SHOP FORGE D2C</strong>
          {% endif %}
        </a>
      </div>

      <!-- Navigation Links (Desktop) -->
      <nav class="sf-desktop-nav">
        <a href="/" class="sf-nav-link">Home</a>
        <a href="/collections/all" class="sf-nav-link">Shop All</a>
        <a href="/pages/about" class="sf-nav-link">Brand Story</a>
        <a href="/pages/faq" class="sf-nav-link">Track Order / Support</a>
      </nav>

      <!-- Utility Actions -->
      <div class="sf-header-actions">
        <a href="/search" class="sf-action-icon" aria-label="Search">🔍</a>
        <a href="/pages/wishlist" class="sf-action-icon" aria-label="Wishlist">
          ❤️ <span class="sf-badge-count">0</span>
        </a>
        <button type="button" class="sf-action-icon sf-cart-icon-btn" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')" aria-label="Cart">
          🛒 <span class="sf-badge-count sf-cart-badge">{{ cart.item_count | default: 0 }}</span>
        </button>
      </div>
    </div>
  </header>
</div>

<style>
  .sf-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 9999;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .sf-ticker-bar {
    padding: 8px 0;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .sf-main-header {
    padding: 16px 0;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  .sf-logo strong {
    font-size: 1.3rem;
    letter-spacing: -0.5px;
  }
  .sf-desktop-nav {
    display: none;
    gap: 28px;
  }
  @media (min-width: 768px) {
    .sf-desktop-nav {
      display: flex;
    }
    .sf-mobile-menu-toggle {
      display: none;
    }
  }
  .sf-nav-link {
    text-decoration: none;
    color: inherit;
    font-weight: 500;
    font-size: 0.92rem;
    transition: opacity 0.2s;
  }
  .sf-nav-link:hover {
    opacity: 0.7;
  }
  .sf-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sf-action-icon {
    background: none;
    border: none;
    font-size: 1.15rem;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .sf-badge-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #ef4444;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
  }
  .sf-mobile-menu-toggle {
    background: none;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
  }
</style>

{% schema %}
{
  "name": "CRO Sticky Header",
  "target": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "SHOP FORGE D2C" },
    { "type": "text", "id": "ticker_msg_1", "label": "Promo Ticker Message 1", "default": "FREE Delivery across India on all prepaid orders!" },
    { "type": "text", "id": "ticker_msg_2", "label": "Promo Ticker Message 2", "default": "Extra 5% OFF on UPI | Code: UPI5" },
    { "type": "color", "id": "ticker_bg", "label": "Ticker Background Color", "default": "#111827" },
    { "type": "color", "id": "ticker_text_color", "label": "Ticker Text Color", "default": "#ffffff" },
    { "type": "color", "id": "header_bg", "label": "Header Background Color", "default": "#ffffff" },
    { "type": "color", "id": "header_text_color", "label": "Header Text Color", "default": "#111827" }
  ]
}
{% endschema %}
