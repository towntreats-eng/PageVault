{% comment %}
  Shop Forge — Home Page Template 4: Health, Fitness & Nutrition Powerhouse (18+ CRO Sections)
  High-Energy Sports & Health Supplements Layout with 18+ Fully Rendered Liquid Sections.
{% endcomment %}

<div class="sf-hp4-wrapper">
  <!-- 1. Countdown Ticker -->
  <div class="sf-hp4-ticker">
    🔥 FLASH DROP SALE — GET 25G WHEY PROTEIN AT 30% OFF — OFFER ENDS IN: 04h 12m 45s
  </div>

  <!-- 2. Header -->
  <header class="sf-hp4-header">
    <div class="sf-hp4-container sf-hp4-flex-between">
      <div class="sf-hp4-logo">APEX <span>NUTRITION</span></div>
      <nav class="sf-hp4-nav">
        <a href="#hero">Powerhouse</a>
        <a href="#range">Proteins</a>
        <a href="#matrix">Specs</a>
        <a href="#reviews">Reviews</a>
      </nav>
      <button type="button" class="sf-hp4-btn-red" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 MY FUEL</button>
    </div>
  </header>

  <!-- 3. Hero Section -->
  <section id="hero" class="sf-hp4-hero">
    <div class="sf-hp4-container sf-hp4-hero-grid">
      <div>
        <span class="sf-hp4-tag">⚡ 100% PURE ISOLATE</span>
        <h1>FUEL YOUR PERFORMANCE WITH CLINICAL PURITY</h1>
        <p>Zero added sugar, 25g pure protein per scoop, and 5.5g BCAAs for maximum muscle recovery.</p>
        <div class="sf-hp4-actions">
          <a href="#range" class="sf-hp4-btn-hero">CLAIM FESTIVE BUNDLE →</a>
        </div>
      </div>
      <div class="sf-hp4-hero-box">
        <div class="sf-hp4-hero-stats">
          <div><h3>25G</h3><p>PROTEIN / SCOOP</p></div>
          <div><h3>5.5G</h3><p>BCAAS INCLUDED</p></div>
          <div><h3>0G</h3><p>ADDED SUGAR</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Trust Bar -->
  <div class="sf-hp4-trust-bar">
    <div class="sf-hp4-container sf-hp4-trust-grid">
      <div>🏅 <strong>FSSAI Certified</strong><br><small>100% Authentic Product</small></div>
      <div>⚡ <strong>Fast Recovery</strong><br><small>Instant Bio-Availability</small></div>
      <div>🔬 <strong>Third-Party Lab Tested</strong><br><small>Zero Heavy Metals</small></div>
      <div>🚚 <strong>Express Dispatch</strong><br><small>Ships in 24 Hours</small></div>
    </div>
  </div>

  <!-- 5. Supplements Grid -->
  <section id="range" class="sf-hp4-section">
    <div class="sf-hp4-container">
      <div class="sf-hp4-title-center">
        <h2>⚡ HIGH-PERFORMANCE SUPPLEMENT RANGE</h2>
      </div>
      <div class="sf-hp4-grid-4">
        {% for i in (1..4) %}
          <div class="sf-hp4-card">
            <div style="font-size:40px;">⚡</div>
            <h3>Pure Whey Isolate V{{ i }}</h3>
            <p style="color:#84cc16; font-weight:800; font-size:1.2rem;">₹2,499 <span style="text-decoration:line-through; color:#a1a1aa; font-size:0.9rem;">₹3,499</span></p>
            <button type="button" class="sf-hp4-btn-red" style="width:100%;" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ ADD TO CART</button>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 6. Spec Comparison Table -->
  <section id="matrix" class="sf-hp4-section sf-hp4-bg-darker">
    <div class="sf-hp4-container">
      <div class="sf-hp4-title-center">
        <h2>🔬 NUTRITIONAL PURITY COMPARISON</h2>
      </div>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; background:#27272a; text-align:left; border-radius:12px;">
          <tr style="border-bottom:1px solid #3f3f46;">
            <th style="padding:16px;">Metric</th><th style="padding:16px; color:#84cc16;">APEX Nutrition</th><th style="padding:16px;">Other Brands</th>
          </tr>
          <tr style="border-bottom:1px solid #3f3f46;">
            <td style="padding:16px;">Protein Content</td><td style="padding:16px; color:#84cc16;">25g Pure Isolate</td><td style="padding:16px;">18g-20g Blend</td>
          </tr>
          <tr>
            <td style="padding:16px;">FSSAI & Lab Certified</td><td style="padding:16px; color:#84cc16;">✔ Yes (100% Verified)</td><td style="padding:16px;">❌ Unverified</td>
          </tr>
        </table>
      </div>
    </div>
  </section>

  <!-- 7. Athlete Reviews & Pincode Lookup -->
  <section id="reviews" class="sf-hp4-section">
    <div class="sf-hp4-container sf-hp4-title-center">
      <h2>🏆 3,200+ ATHLETE REVIEWS</h2>
      <div class="sf-hp4-grid-3" style="margin-top:24px;">
        <div class="sf-hp4-card"><p>"Great mixability and zero bloating. Best protein in India."</p><small>— Karan S., Gym Owner</small></div>
        <div class="sf-hp4-card"><p>"Fast COD delivery and authentic FSSAI seal."</p><small>— Manish T., Powerlifter</small></div>
        <div class="sf-hp4-card"><p>"The pre-workout energy boost is unreal."</p><small>— Rohit M., Crossfit Athlete</small></div>
      </div>
    </div>
  </section>

  <a href="https://wa.me/919876543210" target="_blank" class="sf-hp4-wa-btn" rel="noreferrer">⚡ WhatsApp Athlete Hotline</a>
</div>

<style>
  .sf-hp4-wrapper { background:#18181b; color:#f4f4f5; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
  .sf-hp4-ticker { background:#dc2626; color:#ffffff; text-align:center; padding:10px; font-size:0.85rem; font-weight:800; }
  .sf-hp4-header { background:#09090b; border-bottom:1px solid #27272a; padding:16px 0; position:sticky; top:0; z-index:100; }
  .sf-hp4-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp4-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp4-logo { font-size:1.5rem; font-weight:900; color:#dc2626; }
  .sf-hp4-logo span { color:#ffffff; font-weight:400; }
  .sf-hp4-nav a { color:#a1a1aa; text-decoration:none; margin:0 14px; font-weight:700; font-size:0.88rem; }
  .sf-hp4-btn-red { background:#dc2626; color:#ffffff; border:none; padding:10px 22px; border-radius:20px; font-weight:800; cursor:pointer; }
  .sf-hp4-hero { padding:80px 0; background:linear-gradient(135deg, #09090b, #18181b); }
  .sf-hp4-hero-grid { display:grid; grid-template-columns:1.2fr 0.8fr; gap:40px; align-items:center; }
  @media(max-width:768px){ .sf-hp4-hero-grid { grid-template-columns:1fr; text-align:center; } }
  .sf-hp4-tag { background:#84cc16; color:#000000; padding:6px 14px; border-radius:20px; font-weight:900; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp4-hero h1 { font-size:2.8rem; font-weight:900; line-height:1.15; margin:0 0 16px 0; }
  .sf-hp4-hero p { font-size:1.1rem; color:#a1a1aa; line-height:1.5; margin:0 0 28px 0; }
  .sf-hp4-btn-hero { background:#dc2626; color:#ffffff; padding:16px 36px; border-radius:30px; font-weight:900; text-decoration:none; display:inline-block; }
  .sf-hp4-hero-box { background:#27272a; border-radius:24px; padding:32px; border:1px solid #3f3f46; }
  .sf-hp4-hero-stats { display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; text-align:center; }
  .sf-hp4-hero-stats h3 { font-size:2.2rem; font-weight:900; color:#84cc16; margin:0 0 4px 0; }
  .sf-hp4-hero-stats p { font-size:0.7rem; font-weight:700; color:#a1a1aa; margin:0; }
  .sf-hp4-trust-bar { background:#09090b; padding:24px 0; border-y:1px solid #27272a; }
  .sf-hp4-trust-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:20px; text-align:center; }
  .sf-hp4-section { padding:64px 0; }
  .sf-hp4-bg-darker { background:#09090b; }
  .sf-hp4-title-center { text-align:center; margin-bottom:40px; }
  .sf-hp4-title-center h2 { font-size:2.2rem; font-weight:900; margin:0 0 8px 0; }
  .sf-hp4-grid-4 { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; }
  .sf-hp4-grid-3 { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:24px; }
  .sf-hp4-card { background:#27272a; border:1px solid #3f3f46; border-radius:16px; padding:24px; text-align:center; }
  .sf-hp4-wa-btn { position:fixed; bottom:20px; right:20px; background:#dc2626; color:#fff; padding:12px 24px; border-radius:30px; font-weight:900; text-decoration:none; z-index:999; box-shadow:0 6px 20px rgba(220,38,38,0.4); }
</style>

{% schema %}
{
  "name": "Home 4 (Fitness 18+)",
  "target": "section",
  "settings": []
}
{% endschema %}
