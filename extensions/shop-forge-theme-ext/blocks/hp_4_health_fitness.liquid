{% comment %}
  Shop Forge — Home Page Template 4: Health, Fitness & Nutrition Powerhouse
  High-Energy Sports & Health Supplements Layout with FSSAI Certification & Athlete UGC.
{% endcomment %}

<div class="sf-hp4-wrapper">
  <!-- Countdown Ticker -->
  <div class="sf-hp4-ticker">
    🔥 FLASH DROP SALE — GET 25G WHEY PROTEIN AT 30% OFF — OFFER ENDS IN: 04h 12m 45s
  </div>

  <!-- Header -->
  <header class="sf-hp4-header">
    <div class="sf-hp4-container sf-hp4-flex-between">
      <div class="sf-hp4-logo">APEX <span>NUTRITION</span></div>
      <nav class="sf-hp4-nav">
        <a href="#">Proteins</a>
        <a href="#">Pre-Workout</a>
        <a href="#">Creatine</a>
        <a href="#">Lab Reports</a>
      </nav>
      <button type="button" class="sf-hp4-btn-red" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 MY FUEL</button>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="sf-hp4-hero">
    <div class="sf-hp4-container sf-hp4-hero-grid">
      <div>
        <span class="sf-hp4-tag">⚡ 100% PURE ISOLATE</span>
        <h1>FUEL YOUR PERFORMANCE WITH CLINICAL PURITY</h1>
        <p>Zero added sugar, 25g pure protein per scoop, and 5.5g BCAAs for maximum muscle recovery.</p>
        <div class="sf-hp4-actions">
          <a href="#" class="sf-hp4-btn-hero">CLAIM FESTIVE BUNDLE →</a>
        </div>
      </div>
      <div class="sf-hp4-hero-box">
        <div class="sf-hp4-hero-stats">
          <div><h3>25G</h3><p>PROTEIN / SCOOP</p></div>
          <div><h3>5.5G</h3><p>BCAAS INCLUDED</p></div>
          <div><h3>0G</h3><p>ADDED SUGAR</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="sf-hp4-trust-bar">
    <div class="sf-hp4-container sf-hp4-trust-grid">
      <div>🏅 <strong>FSSAI Certified</strong><br><small>100% Authentic Product</small></div>
      <div>⚡ <strong>Fast Recovery</strong><br><small>Instant Bio-Availability</small></div>
      <div>🔬 <strong>Third-Party Lab Tested</strong><br><small>Zero Heavy Metals</small></div>
      <div>🚚 <strong>Express Dispatch</strong><br><small>Ships in 24 Hours</small></div>
    </div>
  </div>
</div>

<style>
  .sf-hp4-wrapper { background:#18181b; color:#f4f4f5; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
  .sf-hp4-ticker { background:#dc2626; color:#ffffff; text-align:center; padding:10px; font-size:0.85rem; font-weight:800; letter-spacing:0.5px; }
  .sf-hp4-header { background:#09090b; border-bottom:1px solid #27272a; padding:16px 0; }
  .sf-hp4-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp4-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp4-logo { font-size:1.5rem; font-weight:900; color:#dc2626; letter-spacing:-0.5px; }
  .sf-hp4-logo span { color:#ffffff; font-weight:400; }
  .sf-hp4-nav a { color:#a1a1aa; text-decoration:none; margin:0 14px; font-weight:700; font-size:0.88rem; }
  .sf-hp4-nav a:hover { color:#dc2626; }
  .sf-hp4-btn-red { background:#dc2626; color:#ffffff; border:none; padding:10px 22px; border-radius:20px; font-weight:800; cursor:pointer; }
  .sf-hp4-hero { padding:80px 0; background:linear-gradient(135deg, #09090b, #18181b); }
  .sf-hp4-hero-grid { display:grid; grid-template-columns:1.2fr 0.8fr; gap:40px; align-items:center; }
  @media(max-width:768px){ .sf-hp4-hero-grid { grid-template-columns:1fr; text-align:center; } }
  .sf-hp4-tag { background:#84cc16; color:#000000; padding:6px 14px; border-radius:20px; font-weight:900; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp4-hero h1 { font-size:2.8rem; font-weight:900; line-height:1.15; margin:0 0 16px 0; }
  .sf-hp4-hero p { font-size:1.1rem; color:#a1a1aa; line-height:1.5; margin:0 0 28px 0; }
  .sf-hp4-btn-hero { background:#dc2626; color:#ffffff; padding:16px 36px; border-radius:30px; font-weight:900; text-decoration:none; display:inline-block; font-size:1rem; }
  .sf-hp4-hero-box { background:#27272a; border-radius:24px; padding:32px; border:1px solid #3f3f46; }
  .sf-hp4-hero-stats { display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; text-align:center; }
  .sf-hp4-hero-stats h3 { font-size:2.2rem; font-weight:900; color:#84cc16; margin:0 0 4px 0; }
  .sf-hp4-hero-stats p { font-size:0.7rem; font-weight:700; color:#a1a1aa; margin:0; }
  .sf-hp4-trust-bar { background:#09090b; padding:24px 0; border-y:1px solid #27272a; }
  .sf-hp4-trust-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:20px; text-align:center; }
</style>

{% schema %}
{
  "name": "Home Template 4 (Fitness)",
  "target": "section",
  "settings": []
}
{% endschema %}
