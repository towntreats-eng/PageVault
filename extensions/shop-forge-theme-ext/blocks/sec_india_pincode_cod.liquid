{% comment %}
  Shop Forge — India COD & Courier Pincode Serviceability Checker Block
  Starter Tier Feature | Token-driven & Scoped
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shop-forge-blocks.js' | asset_url }}" defer></script>

<div class="sf-block-root" id="sf-pincode-{{ block.id }}">
  <div class="sf-pincode-card">
    <div class="sf-pincode-header">
      <div class="sf-pincode-title">
        <span>🚚</span>
        <span>{{ block.settings.title | default: "Check Delivery & COD Availability" }}</span>
      </div>
      <div class="sf-badge sf-badge-green">
        <span>✓</span> {{ block.settings.cod_badge | default: "COD Available Across India" }}
      </div>
    </div>

    <div class="sf-pincode-form">
      <input
        type="text"
        class="sf-pincode-input"
        placeholder="Enter 6-digit PIN code (e.g. 110001)"
        maxlength="6"
        pattern="\d{6}"
      >
      <button type="button" class="sf-pincode-btn">
        {{ block.settings.button_label | default: "Check Delivery" }}
      </button>
    </div>

    <div class="sf-pincode-result"></div>

    {% if block.settings.show_trustmarks %}
      <div style="margin-top: 12px; font-size: 0.75rem; color: #64748b; display: flex; align-items: center; gap: 8px;">
        <span>🔒 Secure Payments:</span>
        <span style="font-weight: 600;">UPI (Google Pay, PhonePe, Paytm) • Credit/Debit Cards • Net Banking • Cash on Delivery</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "SF India Pincode Checker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Block Title",
      "default": "Check Delivery & COD Availability"
    },
    {
      "type": "text",
      "id": "cod_badge",
      "label": "COD Badge Text",
      "default": "COD Available Across India"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Check Delivery"
    },
    {
      "type": "checkbox",
      "id": "show_trustmarks",
      "label": "Show UPI & Trustmarks Note",
      "default": true
    }
  ]
}
{% endschema %}
