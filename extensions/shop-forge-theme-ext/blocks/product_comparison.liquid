{% comment %}
  Shop Forge — Product Comparison & Spec Matrix Page Block
  Full Page Catalog Item | Token-driven & Responsive
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}

<div class="sf-block-root" id="sf-compare-{{ block.id }}">
  <div style="max-width: 1000px; margin: 0 auto; padding: 20px 16px;">
    <div style="text-align: center; margin-bottom: 32px;">
      <span class="sf-badge sf-badge-green">Side-By-Side Comparison</span>
      <h1 style="font-size: 2rem; font-weight: 800; margin: 8px 0;">
        {{ block.settings.title | default: "Compare Models & Find Your Match" }}
      </h1>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; background: #ffffff; border-radius: var(--sf-border-radius); box-shadow: var(--sf-box-shadow); overflow: hidden; border: 1px solid #e2e8f0;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
            <th style="padding: 16px; text-align: left; font-size: 1rem;">Features & Specs</th>
            <th style="padding: 16px; text-align: center; font-size: 1rem;">Standard Edition</th>
            <th style="padding: 16px; text-align: center; font-size: 1rem; background: #f0fdf4; color: #166534;">
              ⭐ Pro Series (Recommended)
            </th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 16px; font-weight: 700;">Price</td>
            <td style="padding: 14px 16px; text-align: center;">₹1,499</td>
            <td style="padding: 14px 16px; text-align: center; font-weight: 800; color: #166534; background: #f0fdf4;">₹2,499</td>
          </tr>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 16px; font-weight: 700;">Build Material</td>
            <td style="padding: 14px 16px; text-align: center;">Standard Polymer</td>
            <td style="padding: 14px 16px; text-align: center; background: #f0fdf4;">Aerospace Grade Aluminum</td>
          </tr>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 16px; font-weight: 700;">Battery Life</td>
            <td style="padding: 14px 16px; text-align: center;">24 Hours</td>
            <td style="padding: 14px 16px; text-align: center; background: #f0fdf4;">48 Hours Ultra</td>
          </tr>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 16px; font-weight: 700;">Warranty</td>
            <td style="padding: 14px 16px; text-align: center;">6 Months</td>
            <td style="padding: 14px 16px; text-align: center; background: #f0fdf4;">2 Years Comprehensive</td>
          </tr>
          <tr>
            <td style="padding: 14px 16px;"></td>
            <td style="padding: 16px; text-align: center;">
              <button type="button" class="sf-pincode-btn" style="background: #64748b;">Select Standard</button>
            </td>
            <td style="padding: 16px; text-align: center; background: #f0fdf4;">
              <button type="button" class="sf-sticky-btn">Select Pro Series</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF Product Comparison",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Comparison Title",
      "default": "Compare Models & Find Your Match"
    }
  ]
}
{% endschema %}
