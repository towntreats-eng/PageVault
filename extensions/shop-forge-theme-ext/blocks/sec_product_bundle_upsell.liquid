{% comment %}
  Shop Forge — Product Bundle & Frequently Bought Together Upsell Block
  Growth Tier Feature | Token-driven & Responsive
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}

<div class="sf-block-root" id="sf-bundle-{{ block.id }}">
  <div class="sf-bundle-card">
    <div class="sf-bundle-header">
      <span>🎁 {{ block.settings.title | default: "Frequently Bought Together — Save 15%" }}</span>
      <span class="sf-badge sf-badge-green">Bundle Special</span>
    </div>

    <div class="sf-bundle-items">
      <div class="sf-bundle-product">
        <img
          src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200&auto=format&fit=crop&q=80"
          alt="Main Product"
          class="sf-bundle-img"
        >
        <div>
          <div style="font-weight: 700; font-size: 0.9rem;">
            {{ product.title | default: "Signature Leather Minimalist Watch" }}
          </div>
          <div style="font-size: 0.85rem; color: #64748b;">Main Item • {{ product.price | default: "₹2,499" | money }}</div>
        </div>
      </div>

      <div class="sf-plus-icon">+</div>

      <div class="sf-bundle-product">
        <img
          src="https://images.unsplash.com/photo-1608256246200-53e635b5b65f?w=200&auto=format&fit=crop&q=80"
          alt="Complementary Strap"
          class="sf-bundle-img"
        >
        <div>
          <div style="font-weight: 700; font-size: 0.9rem;">Genuine Italian Leather Care Kit</div>
          <div style="font-size: 0.85rem; color: #64748b;">Complementary Accessory • ₹799</div>
        </div>
      </div>
    </div>

    <div class="sf-bundle-footer">
      <div>
        <span style="font-size: 0.85rem; color: #64748b; text-decoration: line-through;">₹3,298</span>
        <div class="sf-bundle-total-price">₹2,799 <span style="font-size: 0.8rem; color: #166534; font-weight: 600;">(Save ₹499)</span></div>
      </div>

      <button type="button" class="sf-sticky-btn" style="padding: 12px 20px;">
        {{ block.settings.btn_text | default: "Add Complete Bundle To Cart" }}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF Product Bundle Upsell",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Bundle Card Title",
      "default": "Frequently Bought Together — Save 15%"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "Add Complete Bundle To Cart"
    }
  ]
}
{% endschema %}
