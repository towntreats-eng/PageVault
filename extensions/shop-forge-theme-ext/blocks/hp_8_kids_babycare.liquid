{% comment %}
  Shop Forge — Home Page Template 8: Kids, Toys & Baby Care Wonderland
  Playful Pastel & Mint Layout for Baby Products & Kids Toys D2C Brands.
{% endcomment %}

<div class="sf-hp8-wrapper">
  <div class="sf-hp8-ticker">🧸 100% NON-TOXIC BPA-FREE TOYS & ORGANIC BABY APPAREL — PEDIATRICIAN APPROVED</div>
  <header class="sf-hp8-header">
    <div class="sf-hp8-container sf-hp8-flex-between">
      <div class="sf-hp8-logo">TINY <span>TOTS</span></div>
      <nav class="sf-hp8-nav"><a href="#hero">Baby Care</a><a href="#toys">Toys</a><a href="#reviews">Parent Reviews</a></nav>
      <button type="button" class="sf-hp8-btn-yellow" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 MY CART (0)</button>
    </div>
  </header>
  <section id="hero" class="sf-hp8-hero">
    <div class="sf-hp8-container sf-hp8-hero-grid">
      <div>
        <span class="sf-hp8-tag">👶 SAFE FOR NEWBORNS</span>
        <h1>GENTLE BABY CARE & SAFELY DESIGNED EDUCATIONAL TOYS</h1>
        <p>Tested for zero harsh chemicals. Gentle on sensitive baby skin and designed for fun learning.</p>
        <a href="#toys" class="sf-hp8-btn-hero">EXPLORE TOY BOXES →</a>
      </div>
      <div class="sf-hp8-hero-box"><span>🧸 Non-Toxic Wooden Toy Set</span></div>
    </div>
  </section>
  <section id="toys" class="sf-hp8-section">
    <div class="sf-hp8-container sf-hp8-title-center">
      <h2>🧸 POPULAR BABY CARE & TOYS</h2>
      <div class="sf-hp8-grid-4">
        {% for i in (1..4) %}
          <div class="sf-hp8-card">
            <div style="font-size:40px;">🧸</div>
            <h3>Organic Toy Set {{ i }}</h3>
            <p style="color:#d97706; font-weight:800;">₹1,199 <span style="text-decoration:line-through; color:#9ca3af;">₹1,999</span></p>
            <button type="button" class="sf-hp8-btn-yellow" style="width:100%;" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ ADD TO BASKET</button>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>
<style>
  .sf-hp8-wrapper { background:#fefce8; color:#713f12; font-family:-apple-system,sans-serif; }
  .sf-hp8-ticker { background:#facc15; color:#713f12; text-align:center; padding:10px; font-size:0.8rem; font-weight:800; }
  .sf-hp8-header { background:#fff; border-b:1px solid #fef08a; padding:16px 0; position:sticky; top:0; z-index:100; }
  .sf-hp8-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp8-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp8-logo { font-size:1.5rem; font-weight:900; color:#ca8a04; }
  .sf-hp8-nav a { color:#854d0e; text-decoration:none; margin:0 14px; font-weight:700; font-size:0.9rem; }
  .sf-hp8-btn-yellow { background:#facc15; color:#713f12; border:none; padding:10px 22px; border-radius:20px; font-weight:800; cursor:pointer; }
  .sf-hp8-hero { padding:80px 0; background:#fef9c3; }
  .sf-hp8-hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; }
  .sf-hp8-tag { background:#fff; color:#ca8a04; padding:6px 14px; border-radius:20px; font-weight:800; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp8-hero h1 { font-size:2.5rem; font-weight:900; color:#713f12; margin:0 0 16px 0; }
  .sf-hp8-hero p { font-size:1.1rem; color:#854d0e; margin:0 0 28px 0; }
  .sf-hp8-btn-hero { background:#ca8a04; color:#fff; padding:16px 32px; border-radius:30px; font-weight:800; text-decoration:none; display:inline-block; }
  .sf-hp8-hero-box { height:320px; background:#fff; border-radius:24px; display:flex; align-items:center; justify-content:center; font-weight:700; color:#854d0e; border:1px solid #fef08a; }
  .sf-hp8-section { padding:64px 0; }
  .sf-hp8-title-center { text-align:center; }
  .sf-hp8-grid-4 { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-top:32px; }
  .sf-hp8-card { background:#fff; border:1px solid #fef08a; padding:24px; border-radius:20px; text-align:center; }
</style>
{% schema %} { "name": "Home 8 (Kids & Toys)", "target": "section", "settings": [] } {% endschema %}
