{% comment %}
  Shop Forge — CRO Slide-Out Cart Drawer Section Block
  High-converting cart drawer with Free Shipping Progress Bar, 1-click Cross-Sells & COD discount incentive.
{% endcomment %}

<div class="sf-cart-drawer-trigger-wrapper">
  <!-- Trigger Button for Theme Editor Preview -->
  <button type="button" class="sf-btn sf-btn-secondary sf-cart-preview-trigger" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">
    🛒 Preview Cart Drawer
  </button>

  <!-- Slide-Out Cart Drawer Overlay -->
  <div id="sf-cart-drawer-overlay" class="sf-cart-overlay">
    <div class="sf-cart-drawer">
      <!-- Drawer Header -->
      <div class="sf-cart-header">
        <div class="sf-flex-between">
          <h3 class="sf-cart-title">Your Cart (<span class="sf-cart-count">{{ cart.item_count | default: 2 }}</span>)</h3>
          <button type="button" class="sf-cart-close" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.remove('sf-active')">✕</button>
        </div>

        <!-- Free Shipping Progress Bar -->
        <div class="sf-shipping-bar-wrapper">
          <p class="sf-shipping-bar-text">
            🎁 Add <strong>₹499</strong> more for <strong>FREE Express Shipping!</strong>
          </p>
          <div class="sf-progress-bg">
            <div class="sf-progress-fill" style="width: 65%;"></div>
          </div>
        </div>
      </div>

      <!-- Drawer Body Items -->
      <div class="sf-cart-body">
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            <div class="sf-cart-item">
              <img src="{{ item.image | img_url: '120x120' }}" alt="{{ item.title }}" class="sf-cart-item-img">
              <div class="sf-cart-item-info">
                <h4>{{ item.product.title }}</h4>
                <p class="sf-cart-item-variant">{{ item.variant.title }}</p>
                <div class="sf-flex-between sf-margin-top-sm">
                  <span class="sf-cart-item-price">{{ item.final_line_price | money }}</span>
                  <div class="sf-qty-selector">
                    <button type="button">-</button>
                    <span>{{ item.quantity }}</span>
                    <button type="button">+</button>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Demo Cart Items for Theme Preview -->
          <div class="sf-cart-item">
            <div class="sf-cart-item-img-placeholder">🛍️</div>
            <div class="sf-cart-item-info">
              <h4>Flagship D2C Best-Seller Product</h4>
              <p class="sf-cart-item-variant">Default Title / Black</p>
              <div class="sf-flex-between sf-margin-top-sm">
                <span class="sf-cart-item-price">₹1,499</span>
                <div class="sf-qty-selector">
                  <button type="button">-</button>
                  <span>1</span>
                  <button type="button">+</button>
                </div>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- 1-Click Cart Cross-Sell Upsell Box -->
        <div class="sf-cart-upsell-box">
          <span class="sf-upsell-tag">🔥 FREQUENTLY ADDED</span>
          <div class="sf-flex-between">
            <div>
              <strong>Protection Plan & Warranty</strong>
              <p>Cover 1-Year Accidental Damage for only ₹199</p>
            </div>
            <button type="button" class="sf-btn sf-btn-sm sf-btn-outline">+ Add (₹199)</button>
          </div>
        </div>
      </div>

      <!-- Drawer Footer & Checkout CTA -->
      <div class="sf-cart-footer">
        <!-- UPI Discount Badge -->
        <div class="sf-upi-incentive-badge">
          ⚡ <strong>Extra 5% OFF</strong> on Prepaid UPI Payments at Checkout!
        </div>

        <div class="sf-flex-between sf-subtotal-row">
          <span>Subtotal</span>
          <strong class="sf-subtotal-price">{{ cart.total_price | money | default: "₹1,499" }}</strong>
        </div>
        <p class="sf-subtotal-note">Taxes, Shipping & Discounts calculated at checkout.</p>

        <a href="/checkout" class="sf-btn sf-btn-primary sf-btn-full sf-checkout-btn">
          🔒 PROCEED TO CHECKOUT
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .sf-cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    z-index: 99999;
    display: opacity;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .sf-cart-overlay.sf-active {
    opacity: 1;
    pointer-events: auto;
  }
  .sf-cart-drawer {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 440px;
    height: 100%;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 30px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .sf-cart-overlay.sf-active .sf-cart-drawer {
    transform: translateX(0);
  }
  .sf-cart-header {
    padding: 20px;
    border-bottom: 1px solid #e5e7eb;
    background: #f9fafb;
  }
  .sf-cart-title {
    margin: 0;
    font-size: 1.15rem;
    color: #111827;
  }
  .sf-cart-close {
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: #6b7280;
  }
  .sf-shipping-bar-wrapper {
    margin-top: 14px;
  }
  .sf-shipping-bar-text {
    margin: 0 0 6px 0;
    font-size: 0.82rem;
    color: #374151;
  }
  .sf-progress-bg {
    height: 8px;
    background: #e5e7eb;
    border-radius: 4px;
    overflow: hidden;
  }
  .sf-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #10b981);
    border-radius: 4px;
  }
  .sf-cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
  .sf-cart-item {
    display: flex;
    gap: 14px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid #f3f4f6;
  }
  .sf-cart-item-img, .sf-cart-item-img-placeholder {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    object-fit: cover;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }
  .sf-cart-item-info h4 {
    margin: 0 0 4px 0;
    font-size: 0.92rem;
    color: #111827;
  }
  .sf-cart-item-variant {
    margin: 0;
    font-size: 0.78rem;
    color: #6b7280;
  }
  .sf-cart-item-price {
    font-weight: 700;
    color: #111827;
  }
  .sf-qty-selector {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
  }
  .sf-qty-selector button {
    background: none;
    border: none;
    padding: 2px 8px;
    cursor: pointer;
  }
  .sf-qty-selector span {
    padding: 0 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .sf-cart-upsell-box {
    background: #eff6ff;
    border: 1px dashed #3b82f6;
    padding: 14px;
    border-radius: 10px;
    margin-top: 16px;
  }
  .sf-upsell-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: #1d4ed8;
    display: block;
    margin-bottom: 4px;
  }
  .sf-cart-footer {
    padding: 20px;
    border-top: 1px solid #e5e7eb;
    background: #ffffff;
  }
  .sf-upi-incentive-badge {
    background: #ecfdf5;
    color: #065f46;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    margin-bottom: 14px;
    text-align: center;
  }
  .sf-subtotal-row {
    font-size: 1.05rem;
  }
  .sf-subtotal-note {
    margin: 4px 0 16px 0;
    font-size: 0.78rem;
    color: #6b7280;
  }
  .sf-checkout-btn {
    padding: 14px;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
  }
</style>

{% schema %}
{
  "name": "CRO Slide-Out Cart Drawer",
  "target": "section",
  "settings": [
    { "type": "text", "id": "free_shipping_threshold", "label": "Free Shipping Threshold (₹)", "default": "499" },
    { "type": "color", "id": "btn_color", "label": "Checkout Button Color", "default": "#10b981" }
  ]
}
{% endschema %}
