{% comment %}
  Shop Forge — HP2 Section 1: Hero Editorial Lookbook
  Luxury Fashion theme with split screen design and elegant typography.
{% endcomment %}

<div class="sf-hp2-hero-wrapper">
  <div class="sf-hp2-hero-split">
    <div class="sf-hp2-hero-content">
      <p class="sf-hp2-hero-kicker">{{ block.settings.kicker | default: "NEW ARRIVALS" }}</p>
      <h1 class="sf-hp2-hero-headline">{{ block.settings.title | default: "The Resort Collection" }}</h1>
      <p class="sf-hp2-hero-sub">{{ block.settings.subtitle | default: "Effortless elegance designed for the modern muse." }}</p>
      <a href="#" class="sf-hp2-btn-luxury">{{ block.settings.btn_text | default: "SHOP THE LOOKBOOK" }}</a>
    </div>
    <div class="sf-hp2-hero-image" style="background-image: url('{{ block.settings.image_url | default: 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop' }}');">
    </div>
  </div>
</div>

<style>
  .sf-hp2-hero-wrapper {
    background-color: #fcfbf9;
    color: #1a1a1a;
    font-family: 'Playfair Display', serif;
  }
  .sf-hp2-hero-split {
    display: flex;
    flex-wrap: wrap;
    min-height: 80vh;
  }
  .sf-hp2-hero-content {
    flex: 1 1 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 8%;
    min-width: 300px;
  }
  .sf-hp2-hero-kicker {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
    color: #8c7e6b;
    margin-bottom: 20px;
  }
  .sf-hp2-hero-headline {
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 24px 0;
    color: #1a1a1a;
  }
  .sf-hp2-hero-sub {
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
    font-size: 1.1rem;
    color: #4a4a4a;
    margin: 0 0 40px 0;
    max-width: 400px;
    line-height: 1.6;
  }
  .sf-hp2-btn-luxury {
    display: inline-block;
    background: #1a1a1a;
    color: #ffffff;
    padding: 18px 40px;
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    text-decoration: none;
    align-self: flex-start;
    transition: background 0.3s ease;
  }
  .sf-hp2-btn-luxury:hover {
    background: #8c7e6b;
  }
  .sf-hp2-hero-image {
    flex: 1 1 50%;
    background-size: cover;
    background-position: center;
    min-width: 300px;
    min-height: 50vh;
  }
  @media (max-width: 768px) {
    .sf-hp2-hero-headline { font-size: 3rem; }
    .sf-hp2-hero-content { padding: 40px 24px; }
  }
</style>

{% schema %}
{
  "name": "HP2: Editorial Hero",
  "target": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "NEW ARRIVALS" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Resort Collection" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Effortless elegance designed for the modern muse." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "SHOP THE LOOKBOOK" },
    { "type": "url", "id": "image_url", "label": "Hero Image URL" }
  ]
}
{% endschema %}
