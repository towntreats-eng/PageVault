{% comment %}
  Shop Forge — Home Page Template 10: Festive Drop, Flash Sale & Limited Edition Event
  High-Urgency Crimson & Deep Purple Layout for Festive Sales, Flash Drops & Product Launches.
{% endcomment %}

<div class="sf-hp10-wrapper">
  <div class="sf-hp10-ticker">⚡ FESTIVE DROP EVENT IS LIVE — UP TO 60% OFF — ENDS IN 02h 45m 12s</div>
  <header class="sf-hp10-header">
    <div class="sf-hp10-container sf-hp10-flex-between">
      <div class="sf-hp10-logo">FESTIVE <span>DROP</span></div>
      <nav class="sf-hp10-nav"><a href="#hero">Live Drop</a><a href="#deals">Deals</a><a href="#reviews">Reviews</a></nav>
      <button type="button" class="sf-hp10-btn-drop" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">🛒 MY DEALS (0)</button>
    </div>
  </header>
  <section id="hero" class="sf-hp10-hero">
    <div class="sf-hp10-container sf-hp10-hero-grid">
      <div>
        <span class="sf-hp10-tag">🔥 LIMITED EDITION DROP</span>
        <h1>DIWALI & FESTIVE MEGA DROP — EXCLUSIVE 60% OFF DEALS</h1>
        <p>Grab high-converting bestsellers before stock runs out. Guaranteed fast express shipping before festive holidays.</p>
        <a href="#deals" class="sf-hp10-btn-hero">CLAIM DROP OFFER →</a>
      </div>
      <div class="sf-hp10-hero-box"><span>🎁 Exclusive Festive Gift Box</span></div>
    </div>
  </section>
  <section id="deals" class="sf-hp10-section">
    <div class="sf-hp10-container sf-hp10-title-center">
      <h2>🎁 FESTIVE FLASH DEALS</h2>
      <div class="sf-hp10-grid-4">
        {% for i in (1..4) %}
          <div class="sf-hp10-card">
            <div style="font-size:40px;">🎁</div>
            <h3>Festive Drop Box {{ i }}</h3>
            <p style="color:#eab308; font-weight:900; font-size:1.2rem;">₹1,299 <span style="text-decoration:line-through; color:#a855f7;">₹3,299</span></p>
            <button type="button" class="sf-hp10-btn-drop" style="width:100%;" onclick="document.querySelector('#sf-cart-drawer-overlay').classList.add('sf-active')">+ CLAIM DEAL</button>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>
<style>
  .sf-hp10-wrapper { background:#2e1065; color:#faf5ff; font-family:-apple-system,sans-serif; }
  .sf-hp10-ticker { background:#ef4444; color:#fff; text-align:center; padding:10px; font-size:0.85rem; font-weight:900; }
  .sf-hp10-header { background:#3b0764; border-b:1px solid #581c87; padding:16px 0; position:sticky; top:0; z-index:100; }
  .sf-hp10-container { max-width:1140px; margin:0 auto; padding:0 24px; }
  .sf-hp10-flex-between { display:flex; justify-content:space-between; align-items:center; }
  .sf-hp10-logo { font-size:1.5rem; font-weight:900; color:#eab308; }
  .sf-hp10-logo span { color:#fff; font-weight:400; }
  .sf-hp10-nav a { color:#d8b4fe; text-decoration:none; margin:0 14px; font-weight:700; font-size:0.9rem; }
  .sf-hp10-btn-drop { background:#eab308; color:#000; border:none; padding:10px 22px; border-radius:20px; font-weight:900; cursor:pointer; }
  .sf-hp10-hero { padding:80px 0; background:linear-gradient(135deg, #3b0764, #581c87); }
  .sf-hp10-hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; }
  .sf-hp10-tag { background:#ef4444; color:#fff; padding:6px 14px; border-radius:20px; font-weight:900; font-size:0.8rem; display:inline-block; margin-bottom:16px; }
  .sf-hp10-hero h1 { font-size:2.5rem; font-weight:900; margin:0 0 16px 0; }
  .sf-hp10-hero p { font-size:1.1rem; color:#e9d5ff; margin:0 0 28px 0; }
  .sf-hp10-btn-hero { background:#eab308; color:#000; padding:16px 32px; border-radius:30px; font-weight:900; text-decoration:none; display:inline-block; }
  .sf-hp10-hero-box { height:320px; background:#581c87; border-radius:24px; display:flex; align-items:center; justify-content:center; font-weight:700; color:#eab308; border:1px solid #7e22ce; }
  .sf-hp10-section { padding:64px 0; }
  .sf-hp10-title-center { text-align:center; }
  .sf-hp10-grid-4 { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-top:32px; }
  .sf-hp10-card { background:#3b0764; border:1px solid #7e22ce; padding:24px; border-radius:20px; text-align:center; }
</style>
{% schema %} { "name": "Home 10 (Festive Drop)", "target": "section", "settings": [] } {% endschema %}
