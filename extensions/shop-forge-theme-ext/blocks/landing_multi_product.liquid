{% comment %}
  Shop Forge — Multi-Product Sales Landing Page Block
  Full Page Catalog Item | Token-driven & Mobile First
{% endcomment %}

{{ 'shop-forge-blocks.css' | asset_url | stylesheet_tag }}

<div class="sf-block-root" id="sf-landing-{{ block.id }}">
  <!-- Hero Section -->
  <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; padding: 60px 20px; text-align: center; border-radius: var(--sf-border-radius); margin-bottom: 40px;">
    <span class="sf-badge sf-badge-green" style="background: rgba(22, 101, 52, 0.3); border-color: rgba(34, 197, 94, 0.4); color: #86efac; margin-bottom: 16px;">
      ✨ Festive Special Collection 2026
    </span>
    <h1 style="font-size: 2.5rem; font-weight: 900; margin: 12px 0; line-height: 1.1;">
      {{ block.settings.hero_title | default: "Engineered For Peak Performance" }}
    </h1>
    <p style="font-size: 1.1rem; color: #cbd5e1; max-width: 600px; margin: 0 auto 24px;">
      Discover our award-winning range of premium products designed for everyday excellence.
    </p>
    <a href="#sf-products-grid" class="sf-sticky-btn" style="text-decoration: none; display: inline-block; padding: 14px 28px; font-size: 1rem;">
      Explore Collection — Up to 40% Off
    </a>
  </div>

  <!-- Multi-Product Showcase Grid -->
  <div id="sf-products-grid" style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
    <h2 style="font-size: 1.75rem; font-weight: 800; text-align: center; margin-bottom: 32px;">
      Featured Flagship Models
    </h2>

    <div class="sf-reviews-grid">
      <div class="sf-review-card">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
        <div style="font-weight: 800; font-size: 1.1rem;">Minimalist Watch Edition 1</div>
        <div style="color: #64748b; font-size: 0.9rem;">Sapphire Glass • Genuine Italian Leather</div>
        <div style="font-weight: 800; font-size: 1.2rem; color: #0f172a;">₹2,499</div>
        <button type="button" class="sf-pincode-btn" style="width: 100%; margin-top: 8px;">Buy Now — Free COD</button>
      </div>

      <div class="sf-review-card">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
        <div style="font-weight: 800; font-size: 1.1rem;">Wireless Noise Cancelling Headphones</div>
        <div style="color: #64748b; font-size: 0.9rem;">40-Hour Battery • Active ANC</div>
        <div style="font-weight: 800; font-size: 1.2rem; color: #0f172a;">₹4,999</div>
        <button type="button" class="sf-pincode-btn" style="width: 100%; margin-top: 8px;">Buy Now — Free COD</button>
      </div>

      <div class="sf-review-card">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
        <div style="font-weight: 800; font-size: 1.1rem;">Pro Runner Ultra Sneakers</div>
        <div style="color: #64748b; font-size: 0.9rem;">Memory Cushion • Breathable Knit</div>
        <div style="font-weight: 800; font-size: 1.2rem; color: #0f172a;">₹3,199</div>
        <button type="button" class="sf-pincode-btn" style="width: 100%; margin-top: 8px;">Buy Now — Free COD</button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SF Multi-Product Landing Page",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Engineered For Peak Performance"
    }
  ]
}
{% endschema %}
